+
+      let thickness = this.targetThickness();
+      let scale = window.devicePixelRatio / window.desktopToDeviceScale;
+      let x = event.screenX * scale;
+      let y = event.screenY * scale;
+      let withinHorizontal =
+        x >= rect.left - thickness && x <= rect.right + thickness;
+      let withinVertical =
+        y >= rect.top - thickness && y <= rect.bottom + thickness;
+      let candidates = [];
+
+      if (withinVertical) {
+        let leftDistance = Math.abs(x - rect.left);
+        if (leftDistance <= thickness) {
+          candidates.push({
+            direction: "left",
+            distance: leftDistance,
+            priority: 1,
+          });
+        }
+
+        let rightDistance = Math.abs(x - rect.right);
+        if (rightDistance <= thickness) {
+          candidates.push({
+            direction: "right",
+            distance: rightDistance,
+            priority: 1,
+          });
+        }
+      }
+
+      if (withinHorizontal) {
+        let bottomDistance = Math.abs(y - rect.bottom);
+        if (bottomDistance <= thickness) {
+          candidates.push({
+            direction: "bottom",
+            distance: bottomDistance,
+            priority: 0,
+          });
+        }
+      }
+
+      if (!candidates.length) {
+        return null;
+      }
+
+      candidates.sort(
