+const SECUREOS_APPEARANCE_CHANNEL_ID = "olc-appearance";
+const SECUREOS_APPEARANCE_ORIGIN = "https://localhost";
+const SECUREOS_APPEARANCE_THEMES = new Map([
+  ["dark", "firefox-compact-dark@mozilla.org"],
+  ["light", "firefox-compact-light@mozilla.org"],
+]);
+
+var gSecureOSAppearanceBridge = {
+  _channel: null,
+
+  init() {
+    if (this._channel) {
+      return;
+    }
+
+    this._channel = new WebChannel(
+      SECUREOS_APPEARANCE_CHANNEL_ID,
+      Services.io.newURI(SECUREOS_APPEARANCE_ORIGIN)
+    );
+    this._channel.listen((id, message, target) => {
+      if (target.browser?.ownerGlobal !== window) {
+        return;
+      }
+
+      this.receiveMessage(message, target);
+    });
+  },
+
+  async receiveMessage(message, target) {
+    let data;
+    try {
+      data = await this.handleMessage(message);
+    } catch (error) {
+      data = {
+        error: error.message || String(error),
+      };
+    }
+
+    this._channel.send(
+      {
+        messageId: message?.messageId,
+        data,
+      },
+      target
+    );
+  },
+
+  async handleMessage(message) {
+    switch (message?.command) {
+      case "getAppearance":
+        return {
+          mode: this.currentMode(),
+        };
+      case "setAppearance":
+        return this.setMode(message.data?.mode);
+      default:
+        throw new Error("unsupported appearance command");
+    }
+  },
+
+  currentMode() {
+    switch (Services.prefs.getStringPref("extensions.activeThemeID", "")) {
+      case SECUREOS_APPEARANCE_THEMES.get("dark"):
+        return "dark";
+      case SECUREOS_APPEARANCE_THEMES.get("light"):
+        return "light";
+      default:
+        return "light";
+    }
+  },
+
+  async setMode(mode) {
+    let themeId = SECUREOS_APPEARANCE_THEMES.get(mode);
+    if (!themeId) {
+      throw new Error("mode must be light or dark");
+    }
+
+    let addon = await AddonManager.getAddonByID(themeId);
+    if (!addon) {
+      throw new Error("Firefox built-in theme is unavailable");
+    }
+
+    await addon.enable();
+    return {
+      mode: this.currentMode(),
+    };
+  },
+};
+
+gSecureOSAppearanceBridge.init();
+
 ChromeUtils.defineLazyGetter(this, "RTL_UI", () => {
   return Services.locale.isAppLocaleRTL;
 });
