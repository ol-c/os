diff --git a/browser/base/content/test/general/browser_localhost_shell.js b/browser/base/content/test/general/browser_localhost_shell.js
new file mode 100644
index 0000000..6c0f0d1
--- /dev/null
+++ b/browser/base/content/test/general/browser_localhost_shell.js
@@ -0,0 +1,228 @@
+const SECUREOS_LOCALHOST_URL = "https://localhost";
+
+add_task(async function test_appearance_bridge_contract() {
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+
+  try {
+    ok(
+      win.gSecureOSAppearanceBridge,
+      "The SecureOS appearance bridge should be available in browser chrome"
+    );
+
+    let current = await win.gSecureOSAppearanceBridge.handleMessage({
+      command: "getAppearance",
+    });
+    ok(
+      ["light", "dark"].includes(current.mode),
+      "The appearance bridge should report a supported mode"
+    );
+    await Assert.rejects(
+      win.gSecureOSAppearanceBridge.handleMessage({
+        command: "setAppearance",
+        data: { mode: "auto" },
+      }),
+      /mode must be light or dark/,
+      "The appearance bridge should reject unsupported modes"
+    );
+  } finally {
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
+
+add_task(async function test_new_tab_uses_firefox_new_tab_url() {
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+  let originalOpenTrustedLinkIn = win.openTrustedLinkIn;
+  let openedURL = null;
+  let openedWhere = null;
+
+  try {
+    isnot(
+      win.BROWSER_NEW_TAB_URL,
+      SECUREOS_LOCALHOST_URL,
+      "The SecureOS localhost surface should not replace Firefox's internal new-tab URL"
+    );
+    ok(
+      !win.isBlankPageURL(SECUREOS_LOCALHOST_URL),
+      "The SecureOS localhost surface should keep normal page title handling"
+    );
+
+    win.openTrustedLinkIn = function (url, where, options = {}) {
+      openedURL = url;
+      openedWhere = where;
+      options.resolveOnNewTabCreated?.(win.gBrowser.selectedBrowser);
+    };
+
+    win.BrowserCommands.openTab();
+
+    await TestUtils.waitForCondition(
+      () => openedURL !== null,
+      "Expected the browser new-tab command to open a URL"
+    );
+    is(
+      openedURL,
+      win.BROWSER_NEW_TAB_URL,
+      "Opening a new tab should stay on Firefox's built-in new-tab open path"
+    );
+    is(openedWhere, "tab", "The new-tab command should still open a tab");
+  } finally {
+    win.openTrustedLinkIn = originalOpenTrustedLinkIn;
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
+
+add_task(async function test_close_last_tab_uses_new_tab_replacement_url() {
+  await SpecialPowers.pushPrefEnv({
+    set: [["browser.tabs.closeWindowWithLastTab", false]],
+  });
+
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+  let originalAddTrustedTab = win.gBrowser.addTrustedTab;
+  let replacementURL = null;
+
+  try {
+    let closingTab = win.gBrowser.selectedTab;
+    BrowserTestUtils.startLoadingURIString(
+      closingTab.linkedBrowser,
+      "https://example.com/"
+    );
+    await BrowserTestUtils.browserLoaded(
+      closingTab.linkedBrowser,
+      false,
+      "https://example.com/"
+    );
+
+    win.gBrowser.addTrustedTab = function (url, options) {
+      replacementURL = url;
+      return originalAddTrustedTab.call(this, "about:blank", options);
+    };
+
+    win.gBrowser.removeTab(closingTab, {
+      animate: false,
+      skipPermitUnload: true,
+    });
+
+    await TestUtils.waitForCondition(
+      () => replacementURL !== null,
+      "Expected Firefox to create a replacement tab when closing the final tab"
+    );
+    is(
+      replacementURL,
+      win.BROWSER_NEW_TAB_URL,
+      "Closing the final tab should reopen Firefox's built-in new-tab URL"
+    );
+    is(win.gBrowser.tabs.length, 1, "The browser window should remain open");
+  } finally {
+    win.gBrowser.addTrustedTab = originalAddTrustedTab;
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
+
+add_task(async function test_dom_window_close_last_tab_uses_new_tab_url() {
+  await SpecialPowers.pushPrefEnv({
+    set: [["browser.tabs.closeWindowWithLastTab", false]],
+  });
+
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+  let originalAddTrustedTab = win.gBrowser.addTrustedTab;
+  let replacementURL = null;
+
+  try {
+    let closingTab = win.gBrowser.selectedTab;
+    BrowserTestUtils.startLoadingURIString(
+      closingTab.linkedBrowser,
+      "https://example.com/"
+    );
+    await BrowserTestUtils.browserLoaded(
+      closingTab.linkedBrowser,
+      false,
+      "https://example.com/"
+    );
+
+    win.gBrowser.addTrustedTab = function (url, options) {
+      replacementURL = url;
+      return originalAddTrustedTab.call(this, "about:blank", options);
+    };
+
+    let closeEvent = new win.Event("DOMWindowClose", {
+      bubbles: true,
+      cancelable: true,
+    });
+    closingTab.linkedBrowser.dispatchEvent(closeEvent);
+
+    await TestUtils.waitForCondition(
+      () => replacementURL !== null && win.gBrowser.tabs.length === 1,
+      "Expected a content-requested final-tab close to create a replacement tab"
+    );
+    ok(
+      closeEvent.defaultPrevented,
+      "The browser should consume the content close request after replacing the tab"
+    );
+    is(
+      replacementURL,
+      win.BROWSER_NEW_TAB_URL,
+      "A content-requested final-tab close should reopen Firefox's built-in new-tab URL"
+    );
+    is(win.gBrowser.tabs.length, 1, "The browser window should remain open");
+  } finally {
+    win.gBrowser.addTrustedTab = originalAddTrustedTab;
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
+
+add_task(async function test_closing_non_final_tab_does_not_force_localhost() {
+  await SpecialPowers.pushPrefEnv({
+    set: [["browser.tabs.closeWindowWithLastTab", false]],
+  });
+
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+  let originalAddTrustedTab = win.gBrowser.addTrustedTab;
+  let replacementURL = null;
+
+  try {
+    let firstTab = win.gBrowser.selectedTab;
+    BrowserTestUtils.startLoadingURIString(
+      firstTab.linkedBrowser,
+      "https://example.com/"
+    );
+    await BrowserTestUtils.browserLoaded(
+      firstTab.linkedBrowser,
+      false,
+      "https://example.com/"
+    );
+
+    let secondTab = win.gBrowser.addTab("https://example.org/");
+    await BrowserTestUtils.browserLoaded(
+      secondTab.linkedBrowser,
+      false,
+      "https://example.org/"
+    );
+
+    win.gBrowser.addTrustedTab = function (url, options) {
+      replacementURL = url;
+      return originalAddTrustedTab.call(this, "about:blank", options);
+    };
+
+    win.gBrowser.removeTab(secondTab, {
+      animate: false,
+      skipPermitUnload: true,
+    });
+
+    await TestUtils.waitForCondition(
+      () => win.gBrowser.tabs.length === 1,
+      "Expected the extra tab to close without spawning a replacement tab"
+    );
+    is(
+      replacementURL,
+      null,
+      "Closing a non-final tab should not force the localhost replacement path"
+    );
+    is(
+      win.gBrowser.selectedBrowser.currentURI.spec,
+      "https://example.com/",
+      "The remaining tab should keep its current page"
+    );
+  } finally {
+    win.gBrowser.addTrustedTab = originalAddTrustedTab;
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
