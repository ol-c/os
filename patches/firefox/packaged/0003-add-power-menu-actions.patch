diff --git a/browser/base/content/browser.js b/browser/base/content/browser.js
index c3f4df0..a21c9d4 100644
--- a/browser/base/content/browser.js
+++ b/browser/base/content/browser.js
@@ -473,6 +473,98 @@ var gSecureOSFxaSyncUi = {
 
 gSecureOSFxaSyncUi.init();
 
+var gSecureOSPowerMenu = {
+  _pending: false,
+  powerEndpoint: "https://localhost/api/system/power",
+
+  init() {
+    document.addEventListener("command", this, true);
+    this.setDisabled(false);
+  },
+
+  handleEvent(event) {
+    if (event.type == "command") {
+      this.onCommand(event);
+    }
+  },
+
+  onCommand(event) {
+    let button = event.target.closest?.("[data-olc-power-action]");
+    let action = button?.getAttribute("data-olc-power-action") || null;
+
+    if (!action) {
+      return;
+    }
+
+    event.preventDefault();
+    event.stopPropagation();
+    void this.request(action).catch(() => {});
+  },
+
+  _fetch(url, options) {
+    return fetch(url, options);
+  },
+
+  setDisabled(disabled) {
+    for (let id of [
+      "appMenu-olc-restart-button",
+      "appMenu-olc-shutdown-button",
+    ]) {
+      let button = document.getElementById(id);
+      if (button) {
+        button.disabled = disabled;
+      }
+    }
+  },
+
+  async request(action) {
+    if (action != "shutdown" && action != "restart") {
+      throw new Error("action must be shutdown or restart");
+    }
+    if (this._pending) {
+      return;
+    }
+
+    this._pending = true;
+    this.setDisabled(true);
+    try {
+      let response = await this._fetch(this.powerEndpoint, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+        },
+        body: JSON.stringify({ action }),
+      });
+      let payload = {};
+      try {
+        payload = await response.json();
+      } catch {
+        // The status code remains the source of truth when the body is absent.
+      }
+      if (!response.ok) {
+        throw new Error(payload.error || `failed to ${action}`);
+      }
+      PanelUI.hide();
+    } catch (error) {
+      Cu.reportError(error);
+      this.setDisabled(false);
+      throw error;
+    } finally {
+      this._pending = false;
+    }
+  },
+
+  restart() {
+    return this.request("restart");
+  },
+
+  shutdown() {
+    return this.request("shutdown");
+  },
+};
+
+gSecureOSPowerMenu.init();
+
 ChromeUtils.defineLazyGetter(this, "RTL_UI", () => {
   return Services.locale.isAppLocaleRTL;
 });
