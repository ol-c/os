+add_task(async function test_power_menu_contract() {
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+
+  try {
+    ok(
+      win.gSecureOSPowerMenu,
+      "The SecureOS power menu controller should be available in browser chrome"
+    );
+    ok(
+      win.document.getElementById("appMenu-olc-restart-button"),
+      "The SecureOS restart menu item should exist"
+    );
+    ok(
+      win.document.getElementById("appMenu-olc-shutdown-button"),
+      "The SecureOS shutdown menu item should exist"
+    );
+
+    let calls = [];
+    let originalFetch = win.gSecureOSPowerMenu._fetch;
+    win.gSecureOSPowerMenu._fetch = async (url, options) => {
+      calls.push({ url, options });
+      return {
+        ok: true,
+        async json() {
+          return {};
+        },
+      };
+    };
+
+    await win.gSecureOSPowerMenu.request("restart");
+
+    is(calls.length, 1, "Expected one localhost power API request");
+    is(
+      calls[0].url,
+      "https://localhost/api/system/power",
+      "Power menu should call the localhost system power endpoint"
+    );
+    is(calls[0].options.method, "POST", "Power menu should use POST");
+    is(
+      calls[0].options.headers["content-type"],
+      "application/json",
+      "Power menu should send JSON"
+    );
+    is(
+      JSON.parse(calls[0].options.body).action,
+      "restart",
+      "Power menu should send the requested action"
+    );
+    await Assert.rejects(
+      win.gSecureOSPowerMenu.request("sleep"),
+      /action must be shutdown or restart/,
+      "Power menu should reject unsupported actions"
+    );
+
+    calls.length = 0;
+    win.document
+      .getElementById("appMenu-olc-shutdown-button")
+      .dispatchEvent(
+        new win.CustomEvent("command", {
+          bubbles: true,
+          cancelable: true,
+        })
+      );
+    await TestUtils.waitForCondition(
+      () => calls.length == 1,
+      "Expected one localhost power API request from the app menu command"
+    );
+    is(
+      JSON.parse(calls[0].options.body).action,
+      "shutdown",
+      "Power menu command should send the requested action"
+    );
+    win.gSecureOSPowerMenu._fetch = originalFetch;
+  } finally {
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
+
 add_task(async function test_new_tab_uses_localhost_url() {
   let win = await BrowserTestUtils.openNewBrowserWindow();
   let originalOpenTrustedLinkIn = win.openTrustedLinkIn;
