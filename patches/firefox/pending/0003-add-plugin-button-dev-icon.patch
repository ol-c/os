diff --git a/browser/base/content/browser.js b/browser/base/content/browser.js
index 20a4c8b..8c2aea8 100644
--- a/browser/base/content/browser.js
+++ b/browser/base/content/browser.js
@@ -429,6 +429,131 @@ var gSecureOSAppearanceBridge = {
 
 gSecureOSAppearanceBridge.init();
 
+var gSecureOSAppearanceToolbarButton = {
+  _button: null,
+  _togglePromise: null,
+  _initialized: false,
+  _waitingForLoad: false,
+  themePref: "extensions.activeThemeID",
+
+  init() {
+    if (this._initialized) {
+      return;
+    }
+
+    if (!this.bindButton()) {
+      if (!this._waitingForLoad) {
+        this._waitingForLoad = true;
+        window.addEventListener("DOMContentLoaded", this, { once: true });
+      }
+      return;
+    }
+
+    this._initialized = true;
+    Services.prefs.addObserver(this.themePref, this);
+    window.addEventListener("unload", this, { once: true });
+    this.syncButton();
+  },
+
+  bindButton() {
+    if (this._button) {
+      return true;
+    }
+
+    this._button = document.getElementById("olc-dev-build-button");
+    if (!this._button) {
+      return false;
+    }
+
+    this._button.addEventListener("command", this);
+    this._waitingForLoad = false;
+    return true;
+  },
+
+  uninit() {
+    if (this._waitingForLoad) {
+      window.removeEventListener("DOMContentLoaded", this);
+      this._waitingForLoad = false;
+    }
+
+    if (!this._initialized) {
+      return;
+    }
+
+    this._initialized = false;
+    Services.prefs.removeObserver(this.themePref, this);
+    if (this._button) {
+      this._button.removeEventListener("command", this);
+    }
+    this._button = null;
+  },
+
+  currentMode() {
+    return gSecureOSAppearanceBridge.currentMode();
+  },
+
+  nextMode() {
+    return this.currentMode() == "dark" ? "light" : "dark";
+  },
+
+  labelForMode(mode) {
+    return mode == "dark" ? "Switch to light mode" : "Switch to dark mode";
+  },
+
+  syncButton() {
+    if (!this._button) {
+      return;
+    }
+
+    let mode = this.currentMode();
+    this._button.setAttribute("olc-appearance-mode", mode);
+    this._button.setAttribute("aria-label", this.labelForMode(mode));
+    this._button.setAttribute("tooltiptext", this.labelForMode(mode));
+    this._button.setAttribute("aria-pressed", mode == "dark" ? "true" : "false");
+  },
+
+  async toggle() {
+    if (this._togglePromise) {
+      return this._togglePromise;
+    }
+
+    this._button?.setAttribute("disabled", "true");
+    this._togglePromise = gSecureOSAppearanceBridge
+      .setMode(this.nextMode())
+      .catch(error => {
+        Cu.reportError(error);
+      })
+      .finally(() => {
+        this._button?.removeAttribute("disabled");
+        this._togglePromise = null;
+        this.syncButton();
+      });
+    return this._togglePromise;
+  },
+
+  handleEvent(event) {
+    switch (event.type) {
+      case "DOMContentLoaded":
+        this.init();
+        break;
+      case "command":
+        this.toggle();
+        break;
+      case "unload":
+        this.uninit();
+        break;
+    }
+  },
+
+  observe(subject, topic, prefName) {
+    if (topic == "nsPref:changed" && prefName == this.themePref) {
+      this.syncButton();
+    }
+  },
+};
+
+gSecureOSAppearanceToolbarButton.init();
+
 const SECUREOS_FXA_SYNC_UI_STYLE_ID = "olc-fxa-sync-ui-style";
 
 var gSecureOSFxaSyncUi = {
