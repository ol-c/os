+add_task(async function test_appearance_toolbar_button_toggles_theme() {
+  let win = await BrowserTestUtils.openNewBrowserWindow();
+
+  try {
+    let button = win.document.getElementById("olc-dev-build-button");
+    ok(button, "The SecureOS appearance toolbar button should exist");
+    ok(
+      win.gSecureOSAppearanceToolbarButton,
+      "The SecureOS appearance toolbar controller should be available"
+    );
+    await TestUtils.waitForCondition(
+      () =>
+        win.gSecureOSAppearanceToolbarButton._initialized &&
+        win.gSecureOSAppearanceToolbarButton._button == button,
+      "Expected the appearance toolbar controller to bind to the toolbar button"
+    );
+
+    let originalMode = win.gSecureOSAppearanceBridge.currentMode();
+    let toggledMode = originalMode == "dark" ? "light" : "dark";
+    let originalAction =
+      originalMode == "dark"
+        ? "Switch to light mode"
+        : "Switch to dark mode";
+    let toggledAction =
+      toggledMode == "dark"
+        ? "Switch to light mode"
+        : "Switch to dark mode";
+
+    is(
+      button.getAttribute("olc-appearance-mode"),
+      originalMode,
+      "The toolbar button should reflect the current appearance mode"
+    );
+    is(
+      button.getAttribute("tooltiptext"),
+      originalAction,
+      "The toolbar button should advertise the next appearance mode"
+    );
+
+    button.click();
+
+    await TestUtils.waitForCondition(
+      () => win.gSecureOSAppearanceBridge.currentMode() == toggledMode,
+      "Expected the toolbar button to toggle the browser appearance mode"
+    );
+    await TestUtils.waitForCondition(
+      () => button.getAttribute("olc-appearance-mode") == toggledMode,
+      "Expected the toolbar button icon state to follow the new appearance mode"
+    );
+
+    is(
+      button.getAttribute("tooltiptext"),
+      toggledAction,
+      "The toolbar button should update its next-mode label after toggling"
+    );
+    is(
+      button.getAttribute("aria-pressed"),
+      toggledMode == "dark" ? "true" : "false",
+      "The toolbar button should expose whether dark mode is active"
+    );
+
+    await win.gSecureOSAppearanceBridge.setMode(originalMode);
+    await TestUtils.waitForCondition(
+      () => button.getAttribute("olc-appearance-mode") == originalMode,
+      "Expected the toolbar button to restore the original appearance state"
+    );
+  } finally {
+    await BrowserTestUtils.closeWindow(win);
+  }
+});
