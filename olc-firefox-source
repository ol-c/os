#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
LOCK_FILE="${ROOT_DIR}/flake.lock"
SOURCE_ROOT="${OLC_SOURCE_ROOT:-${ROOT_DIR}}"
WORKSPACE_ROOT="${OLC_FIREFOX_SOURCE_WORKSPACE_ROOT:-${SOURCE_ROOT}/.olc-firefox}"
CACHE_ROOT="${WORKSPACE_ROOT}/cache"
PACKAGED_PATCH_DIR="${OLC_FIREFOX_PACKAGED_PATCH_DIR:-${SOURCE_ROOT}/patches/firefox/packaged}"
PENDING_PATCH_DIR="${OLC_FIREFOX_PENDING_PATCH_DIR:-${SOURCE_ROOT}/patches/firefox/pending}"
SYSTEM_NAME="${OLC_FIREFOX_BUILD_SYSTEM:-x86_64-linux}"

die() {
  echo "error: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

need_cmd nix-build
need_cmd nix-instantiate
need_cmd nix
need_cmd patch
need_cmd tar
need_cmd sha256sum

if [ ! -f "$LOCK_FILE" ]; then
  die "flake.lock not found: $LOCK_FILE"
fi

resolve_firefox_identity() {
  local metadata
  metadata="$(
    cd "$ROOT_DIR"
    nix-instantiate \
      --eval \
      --strict \
      --raw \
      -E '
        let
          lock = builtins.fromJSON (builtins.readFile ./flake.lock);
          nixpkgsLock = lock.nodes.nixpkgs.locked;
          nixpkgs = builtins.fetchTree {
            type = "github";
            owner = nixpkgsLock.owner;
            repo = nixpkgsLock.repo;
            rev = nixpkgsLock.rev;
            narHash = nixpkgsLock.narHash;
          };
          pkgs = import nixpkgs { system = "'"$SYSTEM_NAME"'"; };
          src = pkgs.firefox-unwrapped.src;
          sourceName =
            if src ? name then src.name else builtins.baseNameOf src.outPath;
        in builtins.concatStringsSep "\n" [
          ("firefox_version=" + pkgs.firefox-unwrapped.version)
          ("nixpkgs_rev=" + nixpkgsLock.rev)
          ("source_archive_store_path=" + src.outPath)
          ("source_archive_basename=" + builtins.baseNameOf src.outPath)
          ("source_name=" + sourceName)
        ]
      '
  )"
  eval "$metadata"
}

realize_source_archive() {
  cd "$ROOT_DIR"
  SOURCE_ARCHIVE_STORE_REALIZED="$(
    nix-build \
      -E '
        let
          lock = builtins.fromJSON (builtins.readFile ./flake.lock);
          nixpkgsLock = lock.nodes.nixpkgs.locked;
          nixpkgs = builtins.fetchTree {
            type = "github";
            owner = nixpkgsLock.owner;
            repo = nixpkgsLock.repo;
            rev = nixpkgsLock.rev;
            narHash = nixpkgsLock.narHash;
          };
          pkgs = import nixpkgs { system = "'"$SYSTEM_NAME"'"; };
        in pkgs.firefox-unwrapped.src
      ' \
      --no-out-link
  )"
}

collect_patch_stack() {
  PATCH_STACK=()

  if [ ! -d "$PACKAGED_PATCH_DIR" ]; then
    die "Firefox packaged patch directory not found: $PACKAGED_PATCH_DIR"
  fi

  while IFS= read -r patch_file; do
    PATCH_STACK+=("$patch_file")
  done < <(find "$PACKAGED_PATCH_DIR" -maxdepth 1 -type f -name '*.patch' | sort)

  if [ "${#PATCH_STACK[@]}" -eq 0 ]; then
    die "no Firefox packaged patches found in $PACKAGED_PATCH_DIR"
  fi

  if [ -d "$PENDING_PATCH_DIR" ]; then
    while IFS= read -r patch_file; do
      PATCH_STACK+=("$patch_file")
    done < <(find "$PENDING_PATCH_DIR" -maxdepth 1 -type f -name '*.patch' | sort)
  fi
}

compute_patch_fingerprint() {
  local digest_input=""
  local patch_file
  for patch_file in "${PATCH_STACK[@]}"; do
    digest_input+="$("$patch_file_sha256_bin" "$patch_file")"$'\n'
  done
  PATCH_FINGERPRINT="$(printf '%s' "$digest_input" | sha256sum | awk '{print $1}')"
}

sha256_line() {
  sha256sum "$1" | awk '{print $1 "  " $2}'
}

patch_file_sha256_bin=sha256_line

setup_instance_paths() {
  local source_store_id
  local nixpkgs_short_rev
  source_store_id="${source_archive_basename}"
  SOURCE_STORE_HASH="${source_store_id%%-*}"
  nixpkgs_short_rev="${nixpkgs_rev:0:12}"
  INSTANCE_ID="firefox-${firefox_version}-${SOURCE_STORE_HASH}-${nixpkgs_short_rev}"
  CACHE_ID="${INSTANCE_ID}"
  CACHE_INSTANCE_ROOT="${CACHE_ROOT}/${CACHE_ID}"
  CACHED_SOURCE_ARCHIVE_PATH="${CACHE_INSTANCE_ROOT}/${source_archive_basename}"
  PRISTINE_SOURCE_DIR="${CACHE_INSTANCE_ROOT}/source"
  CACHE_MANIFEST_PATH="${CACHE_INSTANCE_ROOT}/manifest.env"
  INSTANCE_ROOT="${WORKSPACE_ROOT}/instances/${INSTANCE_ID}"
  SOURCE_DIR="${INSTANCE_ROOT}/source"
  OBJDIR="${INSTANCE_ROOT}/objdir"
  STATE_DIR="${INSTANCE_ROOT}/state"
  PROFILE_DIR="${INSTANCE_ROOT}/profile"
  MOZCONFIG_PATH="${INSTANCE_ROOT}/mozconfig"
  MANIFEST_PATH="${INSTANCE_ROOT}/manifest.env"
}

write_mozconfig() {
  {
    printf '%s\n' '# Auto-generated by olc-firefox-source.'
    printf 'mk_add_options MOZ_OBJDIR=%s\n' "${OBJDIR}"
    printf '%s\n' 'mk_add_options AUTOCLOBBER=1'
    printf '%s\n' 'ac_add_options --enable-project=browser'
    printf '%s\n' 'ac_add_options --with-libclang-path=${LIBCLANG_PATH:-}'
    printf '%s\n' 'ac_add_options --with-wasi-sysroot=${OLC_FIREFOX_WASI_SYSROOT:-}'
  } > "$MOZCONFIG_PATH"
}

write_manifest() {
  local patch_stack_quoted
  printf -v patch_stack_quoted '%q ' "${PATCH_STACK[@]}"
  patch_stack_quoted="${patch_stack_quoted% }"
  cat > "$MANIFEST_PATH" <<EOF
instance_id=$(printf '%q' "${INSTANCE_ID}")
firefox_version=$(printf '%q' "${firefox_version}")
nixpkgs_rev=$(printf '%q' "${nixpkgs_rev}")
source_archive_store_path=$(printf '%q' "${source_archive_store_path}")
cached_source_archive=$(printf '%q' "${CACHED_SOURCE_ARCHIVE_PATH}")
source_store_hash=$(printf '%q' "${SOURCE_STORE_HASH}")
source_dir=$(printf '%q' "${SOURCE_DIR}")
objdir=$(printf '%q' "${OBJDIR}")
state_dir=$(printf '%q' "${STATE_DIR}")
profile_dir=$(printf '%q' "${PROFILE_DIR}")
mozconfig=$(printf '%q' "${MOZCONFIG_PATH}")
packaged_patch_dir=$(printf '%q' "${PACKAGED_PATCH_DIR}")
pending_patch_dir=$(printf '%q' "${PENDING_PATCH_DIR}")
patch_fingerprint=$(printf '%q' "${PATCH_FINGERPRINT}")
patch_stack='${patch_stack_quoted}'
EOF
}

write_cache_manifest() {
  mkdir -p "$CACHE_INSTANCE_ROOT"
  cat > "$CACHE_MANIFEST_PATH" <<EOF
cache_id=$(printf '%q' "${CACHE_ID}")
firefox_version=$(printf '%q' "${firefox_version}")
nixpkgs_rev=$(printf '%q' "${nixpkgs_rev}")
source_archive_store_path=$(printf '%q' "${source_archive_store_path}")
cached_source_archive=$(printf '%q' "${CACHED_SOURCE_ARCHIVE_PATH}")
source_store_hash=$(printf '%q' "${SOURCE_STORE_HASH}")
pristine_source_dir=$(printf '%q' "${PRISTINE_SOURCE_DIR}")
EOF
}

apply_patch_stack() {
  local patch_file
  for patch_file in "${PATCH_STACK[@]}"; do
    (
      cd "$SOURCE_DIR"
      patch -p1 --no-backup-if-mismatch < "$patch_file"
    )
  done
}

prepare_pristine_source_cache() {
  local extract_root

  ensure_cached_source_archive

  if [ -d "$PRISTINE_SOURCE_DIR" ] && [ -f "$CACHE_MANIFEST_PATH" ]; then
    write_cache_manifest
    return 0
  fi

  mkdir -p "$CACHE_ROOT"
  extract_root="${CACHE_INSTANCE_ROOT}.extracting"
  rm -rf "$extract_root"
  mkdir -p "$extract_root"
  tar -xJf "$CACHED_SOURCE_ARCHIVE_PATH" --strip-components=1 -C "$extract_root"
  rm -rf "$CACHE_INSTANCE_ROOT"
  mkdir -p "$CACHE_INSTANCE_ROOT"
  mv "$extract_root" "$PRISTINE_SOURCE_DIR"
  write_cache_manifest
}

ensure_cached_source_archive() {
  if [ -f "$CACHED_SOURCE_ARCHIVE_PATH" ]; then
    return 0
  fi

  realize_source_archive
  mkdir -p "$CACHE_INSTANCE_ROOT"
  cp -f "$SOURCE_ARCHIVE_STORE_REALIZED" "$CACHED_SOURCE_ARCHIVE_PATH"
}

load_manifest() {
  if [ ! -f "$MANIFEST_PATH" ]; then
    return 1
  fi
  # shellcheck disable=SC1090
  . "$MANIFEST_PATH"
}

load_cache_manifest() {
  if [ ! -f "$CACHE_MANIFEST_PATH" ]; then
    return 1
  fi
  # shellcheck disable=SC1090
  . "$CACHE_MANIFEST_PATH"
}

copy_pristine_source_tree() {
  local copy_root

  rm -rf "$INSTANCE_ROOT"
  mkdir -p "$INSTANCE_ROOT" "$OBJDIR" "$STATE_DIR" "$PROFILE_DIR"
  copy_root="${INSTANCE_ROOT}/source.copying"
  rm -rf "$copy_root"
  mkdir -p "$copy_root"
  cp -a --reflink=auto "$PRISTINE_SOURCE_DIR/." "$copy_root/"
  mv "$copy_root" "$SOURCE_DIR"
}

create_source_tree() {
  prepare_pristine_source_cache
  copy_pristine_source_tree
  apply_patch_stack
  write_mozconfig
  write_manifest
}

prepare_instance() {
  resolve_firefox_identity
  collect_patch_stack
  compute_patch_fingerprint
  setup_instance_paths

  if [ -d "$SOURCE_DIR" ]; then
    load_manifest || true
    if [ "${patch_fingerprint:-}" != "$PATCH_FINGERPRINT" ]; then
      echo "warning: existing Firefox source instance uses a different patch fingerprint." >&2
      echo "warning: run 'olc-firefox-source recreate' to rebuild the shared source tree from the current repo patch stack." >&2
    fi
    write_mozconfig
    write_manifest
    return 0
  fi

  create_source_tree
}

resolve_instance_only() {
  resolve_firefox_identity
  collect_patch_stack
  compute_patch_fingerprint
  setup_instance_paths
  load_cache_manifest || true
}

print_status() {
  resolve_instance_only
  cat <<EOF
instance_id:     ${INSTANCE_ID}
firefox_version: ${firefox_version}
nixpkgs_rev:     ${nixpkgs_rev}
source_archive_store_path:${source_archive_store_path}
cached_source_archive:${CACHED_SOURCE_ARCHIVE_PATH}
source_dir:      ${SOURCE_DIR}
objdir:          ${OBJDIR}
mozconfig:       ${MOZCONFIG_PATH}
profile_dir:     ${PROFILE_DIR}
patches:         ${#PATCH_STACK[@]}
patch_fingerprint:${PATCH_FINGERPRINT}
pristine_source_dir:${PRISTINE_SOURCE_DIR}
archive_ready:   $(if [ -f "$CACHED_SOURCE_ARCHIVE_PATH" ]; then printf true; else printf false; fi)
cache_ready:     $(if [ -d "$PRISTINE_SOURCE_DIR" ]; then printf true; else printf false; fi)
instance_ready:  $(if [ -d "$SOURCE_DIR" ]; then printf true; else printf false; fi)
EOF
}

run_mach() {
  prepare_instance
  exec_in_dev_shell __mach-direct "$@"
}

open_shell() {
  prepare_instance
  exec_in_dev_shell __shell-direct
}

run_mach_direct() {
  cd "$SOURCE_DIR"
  export MOZCONFIG="$MOZCONFIG_PATH"
  export MOZBUILD_STATE_PATH="${STATE_DIR}/mozbuild"
  export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="${MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE:-system}"
  export MOZ_NOSPAM="${MOZ_NOSPAM:-1}"
  export HOST_CC="${HOST_CC:-$CC}"
  export HOST_CXX="${HOST_CXX:-${CXX:-}}"
  export AS="${CC}"
  export HOST_AS="${HOST_CC}"
  validate_dev_shell_env
  exec ./mach "$@"
}

open_shell_direct() {
  cd "$SOURCE_DIR"
  export MOZCONFIG="$MOZCONFIG_PATH"
  export MOZBUILD_STATE_PATH="${STATE_DIR}/mozbuild"
  export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="${MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE:-system}"
  export MOZ_NOSPAM="${MOZ_NOSPAM:-1}"
  export OLC_FIREFOX_SOURCE_DIR="$SOURCE_DIR"
  export OLC_FIREFOX_OBJDIR="$OBJDIR"
  export OLC_FIREFOX_PROFILE_DIR="$PROFILE_DIR"
  export HOST_CC="${HOST_CC:-$CC}"
  export HOST_CXX="${HOST_CXX:-${CXX:-}}"
  export AS="${CC}"
  export HOST_AS="${HOST_CC}"
  validate_dev_shell_env
  exec "${SHELL:-bash}" -l
}

validate_dev_shell_env() {
  [ -n "${CC:-}" ] || die "CC is not set; enter through 'olc-firefox-source shell' or 'olc-firefox-source mach ...'"
  [ -n "${CXX:-}" ] || die "CXX is not set; enter through 'olc-firefox-source shell' or 'olc-firefox-source mach ...'"
  [ -n "${LIBCLANG_PATH:-}" ] || die "LIBCLANG_PATH is not set; enter through 'olc-firefox-source shell' or 'olc-firefox-source mach ...'"
  [ -n "${WASM_CC:-}" ] || die "WASM_CC is not set; enter through 'olc-firefox-source shell' or 'olc-firefox-source mach ...'"
  [ -n "${WASM_CXX:-}" ] || die "WASM_CXX is not set; enter through 'olc-firefox-source shell' or 'olc-firefox-source mach ...'"
  [ -n "${OLC_FIREFOX_WASI_SYSROOT:-}" ] || die "OLC_FIREFOX_WASI_SYSROOT is not set; enter through 'olc-firefox-source shell' or 'olc-firefox-source mach ...'"
  [ -d "${LIBCLANG_PATH}" ] || die "LIBCLANG_PATH does not exist: ${LIBCLANG_PATH}"
  [ -x "${WASM_CC}" ] || die "WASM_CC is not executable: ${WASM_CC}"
  [ -x "${WASM_CXX}" ] || die "WASM_CXX is not executable: ${WASM_CXX}"
  [ -d "${OLC_FIREFOX_WASI_SYSROOT}" ] || die "OLC_FIREFOX_WASI_SYSROOT does not exist: ${OLC_FIREFOX_WASI_SYSROOT}"
}

exec_in_dev_shell() {
  local subcommand="$1"
  shift

  if [ "${OLC_FIREFOX_SOURCE_DEVENV:-0}" = "1" ]; then
    case "$subcommand" in
      __mach-direct)
        run_mach_direct "$@"
        ;;
      __shell-direct)
        open_shell_direct
        ;;
      *)
        die "unknown internal dev-shell subcommand: $subcommand"
        ;;
    esac
  fi

  exec nix develop "${ROOT_DIR}#firefox-source" \
    --command env OLC_FIREFOX_SOURCE_DEVENV=1 bash "$0" "$subcommand" "$@"
}

print_env() {
  prepare_instance
  cat <<EOF
export MOZCONFIG=${MOZCONFIG_PATH}
export MOZBUILD_STATE_PATH=${STATE_DIR}/mozbuild
export OLC_FIREFOX_SOURCE_DIR=${SOURCE_DIR}
export OLC_FIREFOX_OBJDIR=${OBJDIR}
export OLC_FIREFOX_PROFILE_DIR=${PROFILE_DIR}
cd ${SOURCE_DIR}
EOF
}

recreate_instance() {
  resolve_firefox_identity
  collect_patch_stack
  compute_patch_fingerprint
  setup_instance_paths
  create_source_tree
  print_status
}

prepare_cache() {
  resolve_instance_only
  prepare_pristine_source_cache
  print_status
}

usage() {
  cat <<'EOF'
usage: olc-firefox-source <command> [args...]

Commands:
  prepare-cache      Bootstrap or reuse the pristine pinned Firefox source cache.
  prepare            Bootstrap or reuse the shared pinned Firefox source tree.
  status             Show the resolved source-tree instance paths and identity.
  env                Print shell exports for the current source-tree instance.
  shell              Open a login shell inside the shared Firefox source tree.
  mach <args...>     Run ./mach in the shared Firefox source tree.
  recreate           Recreate the shared source tree from the pinned source archive and current patch stack.
EOF
}

case "${1:-status}" in
  prepare-cache)
    prepare_cache
    ;;
  prepare)
    prepare_instance
    print_status
    ;;
  status)
    print_status
    ;;
  env)
    print_env
    ;;
  shell)
    open_shell
    ;;
  mach)
    shift
    [ "$#" -gt 0 ] || die "mach subcommand required"
    run_mach "$@"
    ;;
  recreate)
    recreate_instance
    ;;
  __mach-direct)
    shift
    [ "$#" -gt 0 ] || die "mach subcommand required"
    prepare_instance
    run_mach_direct "$@"
    ;;
  __shell-direct)
    prepare_instance
    open_shell_direct
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
