#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "error: $*" >&2
  exit 1
}

repo_is_olc_virtiofs_mount() {
  local path="$1"

  if ! command -v findmnt >/dev/null 2>&1; then
    return 1
  fi

  while read -r source fs_type; do
    if [[ "$source" == "ol-c-source" && "$fs_type" == "virtiofs" ]]; then
      return 0
    fi
  done < <(findmnt -T "$path" -n -o SOURCE,FSTYPE 2>/dev/null || true)

  return 1
}

resolve_source_dir() {
  if [[ -n "${OLC_SOURCE_DIR:-}" ]]; then
    printf '%s\n' "$OLC_SOURCE_DIR"
    return
  fi

  if [[ -d /source ]] && repo_is_olc_virtiofs_mount /source; then
    printf '%s\n' /source
    return
  fi

  pwd
}

resolve_cached_qemu_bin() {
  local cache_dir cache_file qemu_out candidate

  cache_dir="${VM_WORKSPACE}/cache"
  cache_file="${cache_dir}/qemu-bin"

  if [[ -r "$cache_file" ]]; then
    candidate="$(head -n 1 "$cache_file")"
    if [[ -x "$candidate" ]]; then
      RESOLVED_QEMU_BIN="$candidate"
      return
    fi
  fi

  mkdir -p "$cache_dir"
  qemu_out="$(nix build .#qemu-olc --print-out-paths --no-link)"
  for candidate in \
    "$qemu_out/bin/qemu-system-x86_64" \
    "$qemu_out/bin/qemu-kvm"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate" > "$cache_file"
      RESOLVED_QEMU_BIN="$candidate"
      return
    fi
  done

  fail "unable to locate qemu-system-x86_64 in patched QEMU build output: $qemu_out"
}

resolve_image_path() {
  local image candidate

  if [[ -n "${OLC_VM_IMAGE:-}" ]]; then
    [[ -f "$OLC_VM_IMAGE" ]] || fail "OLC_VM_IMAGE does not point to a file: $OLC_VM_IMAGE"
    printf '%s\n' "$OLC_VM_IMAGE"
    return
  fi

  if [[ -d "$VM_IMAGES_DIR" ]]; then
    candidate="$(
      find "$VM_IMAGES_DIR" -maxdepth 1 -type f \
        \( -name '*.qcow2' -o -name '*.qcow' -o -name '*.img' -o -name '*.raw' \) \
        | LC_ALL=C sort \
        | sed -n '1p'
    )"
    if [[ -n "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  fi

  fail "no VM image found. Set OLC_VM_IMAGE=/path/to/image.qcow2 or expose one in ${VM_IMAGES_DIR}."
}

KVM_DEVICE="${OLC_KVM_DEVICE:-/dev/kvm}"
VM_IMAGES_DIR="${OLC_VM_IMAGES_DIR:-/vm-images}"
VM_WORKSPACE="${OLC_VM_WORKSPACE:-/var/lib/ol-c/vms}"
RESOLVED_QEMU_BIN=""
SOURCE_DIR="$(resolve_source_dir)"
IMAGE_PATH="$(resolve_image_path)"

[[ -d "$SOURCE_DIR" ]] || fail "source directory not found: $SOURCE_DIR"
[[ -x "$SOURCE_DIR/launch-vm" ]] || fail "launch-vm not found or not executable in source directory: $SOURCE_DIR"

if [[ ! -e "$KVM_DEVICE" ]]; then
  fail "${KVM_DEVICE} is required for nested VM development. Enable nested KVM on the Ubuntu host and relaunch ol-c."
fi

if [[ ! -r "$KVM_DEVICE" || ! -w "$KVM_DEVICE" ]]; then
  fail "${KVM_DEVICE} is present but not accessible. Ensure the demo user is in the kvm group and relaunch the session."
fi

mkdir -p "$VM_WORKSPACE/tmp"

if [[ -n "${OLC_QEMU_DISPLAY:-}" ]]; then
  fail "embedded VM launches do not allow OLC_QEMU_DISPLAY overrides; use the browser-tab viewer only."
fi

if [[ -n "${OLC_QEMU_FRONTEND:-}" && "${OLC_QEMU_FRONTEND}" != "browser" ]]; then
  fail "embedded VM launches do not allow OLC_QEMU_FRONTEND=${OLC_QEMU_FRONTEND}; use the browser-tab viewer only."
fi

export OLC_SOURCE_DIR="$SOURCE_DIR"
export OLC_VM_IMAGE="$IMAGE_PATH"
export OLC_QEMU_FRONTEND="browser"
export OLC_VM_SCREEN_OPEN_BROWSER="${OLC_VM_SCREEN_OPEN_BROWSER:-0}"
export OLC_VM_DISK_SIZE="${OLC_VM_DISK_SIZE:-24G}"
export OLC_VM_FAST_BOOT="${OLC_VM_FAST_BOOT:-1}"
export OLC_VM_NETWORK_MODE="${OLC_VM_NETWORK_MODE:-none}"
export OLC_SHARE_VM_IMAGES="${OLC_SHARE_VM_IMAGES:-0}"
export TMPDIR="${TMPDIR:-${VM_WORKSPACE}/tmp}"
VM_LINEAGE_ENV="${OLC_VM_LINEAGE_ENV:-/run/olc-vm-lineage.env}"

if [[ -r "$VM_LINEAGE_ENV" ]]; then
  # shellcheck disable=SC1091
  . "$VM_LINEAGE_ENV"
  export OLC_VM_PARENT_MACHINE_ID="${OLC_VM_MACHINE_ID:-}"
  export OLC_VM_PARENT_DEPTH="${OLC_VM_DEPTH:-0}"
fi

if [[ -z "${OLC_NOVNC_DIR:-}" && -n "${OLC_DEFAULT_NOVNC_DIR:-}" ]]; then
  export OLC_NOVNC_DIR="$OLC_DEFAULT_NOVNC_DIR"
fi

if [[ -z "${OLC_QEMU_BIN:-}" ]]; then
  if [[ -n "${OLC_DEFAULT_QEMU_BIN:-}" && -x "${OLC_DEFAULT_QEMU_BIN}" ]]; then
    export OLC_QEMU_BIN="$OLC_DEFAULT_QEMU_BIN"
  else
    resolve_cached_qemu_bin
    export OLC_QEMU_BIN="$RESOLVED_QEMU_BIN"
  fi
fi

export OLC_VM_WAIT_READY="${OLC_VM_WAIT_READY:-1}"
export OLC_VM_READY_TIMEOUT_SECONDS="${OLC_VM_READY_TIMEOUT_SECONDS:-30}"
export OLC_VM_READY_WARN_SECONDS="${OLC_VM_READY_WARN_SECONDS:-15}"

echo "source: $OLC_SOURCE_DIR"
echo "image: $OLC_VM_IMAGE"
echo "workspace: $VM_WORKSPACE"
echo "screen: browser tab"
echo "disk size: $OLC_VM_DISK_SIZE"
echo "fast boot: $OLC_VM_FAST_BOOT"
echo "network mode: $OLC_VM_NETWORK_MODE"
echo "share vm images: $OLC_SHARE_VM_IMAGES"

cd "$SOURCE_DIR"
exec "$SOURCE_DIR/launch-vm" "$@"
