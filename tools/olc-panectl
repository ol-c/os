set -euo pipefail

state_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
state_dir="$state_root/ol-c-panes"
pending_file="$state_dir/pending-split.json"

log() {
  printf 'olc-panectl %s\n' "$*" >&2
}

now_ms() {
  date +%s%3N
}

clear_pending() {
  rm -f "$pending_file"
}

valid_direction() {
  case "${1:-}" in
    left|right|top|bottom)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

focused_pane() {
  i3-msg -t get_tree \
    | jq -er 'first(.. | objects | select(.focused? == true) | [.id, .rect.width, .rect.height] | @tsv)'
}

target_pane_at() {
  local x="$1"
  local y="$2"

  i3-msg -t get_tree \
    | jq -er --argjson x "$x" --argjson y "$y" '
        def lower: ascii_downcase;
        def firefox_window:
          ((.window_properties.class? // "" | lower) == "firefox") or
          ((.window_properties.instance? // "" | lower) == "firefox");

        [
          .. | objects
          | select(.window? != null)
          | select(firefox_window)
          | select(
              .rect.x <= $x and $x < (.rect.x + .rect.width) and
              .rect.y <= $y and $y < (.rect.y + .rect.height)
            )
          | {
              id,
              x: .rect.x,
              y: .rect.y,
              width: .rect.width,
              height: .rect.height,
              relX: ($x - .rect.x),
              relY: ($y - .rect.y)
            }
        ]
        | sort_by(.width * .height)
        | first // empty
        | [.id, .width, .height, .relX, .relY, .x, .y]
        | @tsv
      '
}

adjacent_pane_in_direction() {
  local source_id="$1"
  local source_x="$2"
  local source_y="$3"
  local source_width="$4"
  local source_height="$5"
  local direction="$6"

  i3-msg -t get_tree \
    | jq -er \
        --argjson sourceId "$source_id" \
        --argjson sx "$source_x" \
        --argjson sy "$source_y" \
        --argjson sw "$source_width" \
        --argjson sh "$source_height" \
        --arg direction "$direction" '
        def lower: ascii_downcase;
        def firefox_window:
          ((.window_properties.class? // "" | lower) == "firefox") or
          ((.window_properties.instance? // "" | lower) == "firefox");
        def min2(a; b): if a < b then a else b end;
        def max2(a; b): if a > b then a else b end;
        def overlap(a1; a2; b1; b2): min2(a2; b2) - max2(a1; b1);

        [
          .. | objects
          | select(.window? != null)
          | select(firefox_window)
          | select(.id != $sourceId)
          | {
              id,
              width: .rect.width,
              height: .rect.height,
              x: .rect.x,
              y: .rect.y,
              right: (.rect.x + .rect.width),
              bottom: (.rect.y + .rect.height)
            }
          | . + (
              if $direction == "left" then
                { gap: ($sx - .right), overlap: overlap($sy; $sy + $sh; .y; .bottom) }
              elif $direction == "right" then
                { gap: (.x - ($sx + $sw)), overlap: overlap($sy; $sy + $sh; .y; .bottom) }
              elif $direction == "top" then
                { gap: ($sy - .bottom), overlap: overlap($sx; $sx + $sw; .x; .right) }
              else
                { gap: (.y - ($sy + $sh)), overlap: overlap($sx; $sx + $sw; .x; .right) }
              end
            )
          | select(.gap >= 0 and .overlap > 0)
        ]
        | sort_by(.gap, -(.overlap), .id)
        | first // empty
        | [.id, .width, .height]
        | @tsv
      '
}

nearest_direction() {
  local width="$1"
  local height="$2"
  local rel_x="$3"
  local rel_y="$4"
  local direction="left"
  local distance="$rel_x"
  local candidate

  candidate=$(( width - rel_x ))
  if (( candidate < distance )); then
    direction="right"
    distance="$candidate"
  fi

  if (( rel_y < distance )); then
    direction="top"
    distance="$rel_y"
  fi

  candidate=$(( height - rel_y ))
  if (( candidate < distance )); then
    direction="bottom"
  fi

  printf '%s\n' "$direction"
}

prepare_split_for_pane() {
  local direction="$1"
  local container_id="$2"

  mkdir -p "$state_dir"

  if ! i3-msg "[con_id=$container_id] focus" >/dev/null; then
    log "rejecting direction=$direction reason=target-focus-failed con_id=$container_id"
    clear_pending
    exit 1
  fi

  case "$direction" in
    left|right)
      i3-msg split h >/dev/null
      ;;
    top|bottom)
      i3-msg split v >/dev/null
      ;;
  esac

  printf '{"direction":"%s","createdMs":%s,"targetConId":%s}\n' \
    "$direction" "$(now_ms)" "$container_id" > "$pending_file"
}

prepare_split() {
  local direction="${1:-}"
  if ! valid_direction "$direction"; then
    log "rejecting unknown split direction=$direction"
    clear_pending
    exit 2
  fi

  local pane container_id width height
  if ! pane="$(focused_pane)"; then
    log "rejecting direction=$direction reason=missing-focused-i3-container"
    clear_pending
    exit 1
  fi
  IFS=$'\t' read -r container_id width height <<< "$pane"

  prepare_split_for_pane "$direction" "$container_id" "$width" "$height"
}

prepare_split_at() {
  local x="${1:-}"
  local y="${2:-}"
  if ! [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
    log "rejecting split point x=$x y=$y reason=invalid-coordinate"
    clear_pending
    exit 2
  fi

  local source_x="${3:-}"
  local source_y="${4:-}"
  local source_will_close="${5:-0}"
  if [[ -n "$source_x$source_y" ]] && ! [[ "$source_x" =~ ^[0-9]+$ && "$source_y" =~ ^[0-9]+$ ]]; then
    log "rejecting split point x=$x y=$y reason=invalid-source-coordinate source_x=$source_x source_y=$source_y"
    clear_pending
    exit 2
  fi
  if ! [[ "$source_will_close" =~ ^[01]$ ]]; then
    source_will_close=0
  fi

  local pane container_id width height rel_x rel_y _target_x _target_y direction
  if ! pane="$(target_pane_at "$x" "$y")"; then
    log "rejecting split point x=$x y=$y reason=missing-firefox-pane"
    clear_pending
    exit 1
  fi
  IFS=$'\t' read -r container_id width height rel_x rel_y _target_x _target_y <<< "$pane"
  direction="$(nearest_direction "$width" "$height" "$rel_x" "$rel_y")"

  # A last-tab drag from a pane onto that same pane's inner edge would otherwise
  # split beside the pane that is about to close, producing no visible reorder.
  if [[ "$source_will_close" = 1 && -n "$source_x" && -n "$source_y" ]]; then
    local source_pane source_id source_width source_height _source_rel_x _source_rel_y source_rect_x source_rect_y adjacent_pane
    if source_pane="$(target_pane_at "$source_x" "$source_y")"; then
      IFS=$'\t' read -r source_id source_width source_height _source_rel_x _source_rel_y source_rect_x source_rect_y <<< "$source_pane"
      if [[ "$source_id" = "$container_id" ]]; then
        if adjacent_pane="$(adjacent_pane_in_direction "$source_id" "$source_rect_x" "$source_rect_y" "$source_width" "$source_height" "$direction")"; then
          IFS=$'\t' read -r container_id width height <<< "$adjacent_pane"
          log "retargeting closing source split direction=$direction source_con_id=$source_id target_con_id=$container_id"
        fi
      fi
    fi
  fi

  prepare_split_for_pane "$direction" "$container_id" "$width" "$height"
}

firefox_window_event() {
  local event="$1"
  local class instance class_lc instance_lc
  class="$(printf '%s\n' "$event" | jq -r '.container.window_properties.class? // ""')"
  instance="$(printf '%s\n' "$event" | jq -r '.container.window_properties.instance? // ""')"
  class_lc="$(printf '%s' "$class" | tr '[:upper:]' '[:lower:]')"
  instance_lc="$(printf '%s' "$instance" | tr '[:upper:]' '[:lower:]')"
  [ "$class_lc" = firefox ] || [ "$instance_lc" = firefox ]
}

apply_pending_to_window() {
  local container_id="$1"
  local pending direction created_ms ttl_ms age_ms

  [ -s "$pending_file" ] || return 0
  if ! pending="$(cat "$pending_file")"; then
    clear_pending
    return 0
  fi
  direction="$(printf '%s\n' "$pending" | jq -r '.direction? // ""')"
  created_ms="$(printf '%s\n' "$pending" | jq -r '.createdMs? // 0')"
  ttl_ms="${OLC_PANE_PENDING_TTL_MS:-3000}"
  if ! [[ "$ttl_ms" =~ ^[0-9]+$ ]]; then
    ttl_ms=3000
  fi

  if ! [[ "$created_ms" =~ ^[0-9]+$ ]]; then
    clear_pending
    return 0
  fi

  age_ms=$(( $(now_ms) - created_ms ))
  if (( age_ms > ttl_ms )); then
    log "dropping stale pending split direction=$direction age_ms=$age_ms ttl_ms=$ttl_ms"
    clear_pending
    return 0
  fi

  if ! valid_direction "$direction"; then
    clear_pending
    return 0
  fi

  i3-msg "[con_id=$container_id] focus" >/dev/null || true
  case "$direction" in
    left)
      i3-msg move left >/dev/null || true
      ;;
    top)
      i3-msg move up >/dev/null || true
      ;;
  esac
  i3-msg "[con_id=$container_id] focus" >/dev/null || true
  clear_pending
}

watch_windows() {
  mkdir -p "$state_dir"
  i3-msg -t subscribe -m '["window"]' \
    | while IFS= read -r event; do
        local change container_id
        change="$(printf '%s\n' "$event" | jq -r '.change? // ""' 2>/dev/null || true)"
        [ "$change" = new ] || continue
        firefox_window_event "$event" || continue
        container_id="$(printf '%s\n' "$event" | jq -r '.container.id? // empty' 2>/dev/null || true)"
        [ -n "$container_id" ] || continue
        apply_pending_to_window "$container_id"
      done
}

command="${1:-}"
shift || true
case "$command" in
  prepare-split)
    prepare_split "${1:-}"
    ;;
  prepare-split-at)
    prepare_split_at "${1:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}"
    ;;
  clear-pending)
    mkdir -p "$state_dir"
    clear_pending
    ;;
  watch)
    watch_windows
    ;;
  *)
    echo "usage: olc-panectl prepare-split <left|right|top|bottom>|prepare-split-at <x> <y>|clear-pending|watch" >&2
    exit 2
    ;;
esac
