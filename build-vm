#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

usage() {
  cat <<'EOF'
Usage: build-vm

Builds the current OL-C VM image and prints the image path.
EOF
}

fail() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "required command not found: $1"
  fi
}

repo_is_olc_virtiofs_mount() {
  if ! command -v findmnt >/dev/null 2>&1; then
    return 1
  fi

  while read -r source fs_type; do
    if [[ "$source" == "ol-c-source" && "$fs_type" == "virtiofs" ]]; then
      return 0
    fi
  done < <(findmnt -R "$ROOT_DIR" -n -o SOURCE,FSTYPE 2>/dev/null || true)

  return 1
}

nix_store_free_mb() {
  df -Pm /nix 2>/dev/null | awk 'NR == 2 { print $4 }'
}

check_local_build_capacity() {
  local min_free_mb free_mb

  if [[ "${OLC_SKIP_BUILD_CAPACITY_CHECK:-0}" == "1" ]]; then
    return
  fi

  if ! repo_is_olc_virtiofs_mount; then
    return
  fi

  if ! command -v df >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
    return
  fi

  min_free_mb="${OLC_MIN_BUILD_FREE_MB:-2048}"
  free_mb="$(nix_store_free_mb)"
  if [[ -z "$free_mb" || ! "$free_mb" =~ ^[0-9]+$ ]]; then
    return
  fi

  if (( free_mb < min_free_mb )); then
    fail "local VM image build is unsafe inside the OL-C guest: /nix has ${free_mb} MiB free; need at least ${min_free_mb} MiB. Shut down this VM and run ./build-vm on the host, or set OLC_SKIP_BUILD_CAPACITY_CHECK=1 to override."
  fi
}

resolve_image_path() {
  local out_path="$1"

  if [[ -f "$out_path" ]]; then
    printf '%s\n' "$out_path"
    return
  fi

  find "$out_path" -maxdepth 2 -type f \
    \( -name '*.qcow2' -o -name '*.qcow' -o -name '*.img' -o -name '*.raw' \) \
    | LC_ALL=C sort \
    | sed -n '1p'
}

case "${1:-}" in
  "")
    ;;
  --help)
    usage
    exit 0
    ;;
  milestone1|milestone2)
    fail "build-vm no longer accepts milestone arguments; use ./build-vm"
    ;;
  *)
    fail "unknown argument: $1"
    ;;
esac

BUILD_TARGET="${BUILD_TARGET:-.#ol-c-image}"

check_local_build_capacity
require_command nix

NIX_BUILD_OUTPUT="$(
  nix build "$BUILD_TARGET" --print-out-paths --no-link
)"

IMAGE_PATH="$(resolve_image_path "$NIX_BUILD_OUTPUT")"
[[ -n "$IMAGE_PATH" ]] || fail "unable to locate a bootable disk image in nix build output: $NIX_BUILD_OUTPUT"

printf '%s\n' "$IMAGE_PATH"
