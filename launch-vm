#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: launch-vm [options]

Options:
  --cpus N          Guest vCPU count. Default: 2.
  --memory MB       Guest memory in megabytes. Default: 4096.
  --help            Show this help text.

Environment:
  OLC_VM_IMAGE      Existing VM image to boot. Skips build-vm when set.
  OLC_SHARE_VM_IMAGES
                          Mount the boot image directory at /vm-images. Default: 1.
  OLC_QEMU_FRONTEND
                          Graphical frontend: browser, spice, sdl, or gtk. Default: browser.
  OLC_QEMU_DISPLAY  Direct QEMU display backend for debugging. Overrides frontend.
  OLC_NOVNC_DIR           noVNC asset directory. Default: built from .#novnc.
  OLC_VM_SCREEN_OPEN_BROWSER
                          Open the browser viewer with xdg-open. Default: 1.
  OLC_VM_SCREEN_PORT      Local browser viewer HTTP port. Default: automatic.
  OLC_QEMU_SDL_VIDEO_HIGHDPI_DISABLED
                          SDL HiDPI mode for QEMU's own window. Default: 1.
  OLC_QEMU_GDK_SCALE
                          GTK scale if using a GTK display backend. Default: 1.
  OLC_QEMU_GDK_DPI_SCALE
                          GTK text DPI scale if using a GTK display backend. Default: 1.
  OLC_SOURCE_DIR          Host source tree to mount at /source. Default: this repo.
  OLC_VIRTIOFSD           virtiofsd executable path. Default: first virtiofsd in PATH.
  OLC_VIRTIOFSD_SANDBOX   virtiofsd sandbox mode. Default: none.
  OLC_KVM_DEVICE          KVM device path. Default: /dev/kvm.
EOF
}

fail() {
  echo "error: $*" >&2
  exit 1
}

fail_missing_virtiofsd() {
  cat >&2 <<'EOF'
error: required command not found: virtiofsd

Install the host virtiofs daemon, then rerun ./launch-vm.

Ubuntu:
  sudo apt update
  sudo apt install -y virtiofsd

If virtiofsd is installed in a non-standard location, set:
  OLC_VIRTIOFSD=/path/to/virtiofsd ./launch-vm
EOF
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "required command not found: $1"
  fi
}

resolve_command() {
  command -v "$1" 2>/dev/null || true
}

resolve_virtiofsd() {
  local candidate

  candidate="$(resolve_command virtiofsd)"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return
  fi

  for candidate in /usr/lib/qemu/virtiofsd /usr/libexec/virtiofsd; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}

resolve_novnc_dir() {
  local out_path candidate

  if [[ -n "${OLC_NOVNC_DIR:-}" ]]; then
    printf '%s\n' "$OLC_NOVNC_DIR"
    return
  fi

  out_path="$(nix build .#novnc --print-out-paths --no-link)"
  for candidate in \
    "$out_path/share/webapps/novnc" \
    "$out_path/share/webapps/noVNC" \
    "$out_path/share/novnc" \
    "$out_path/share/noVNC" \
    "$out_path"; do
    if [[ -f "$candidate/core/rfb.js" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  fail "unable to locate noVNC core/rfb.js in nix build output: $out_path"
}

port_is_open() {
  local port="$1"

  timeout 0.2 bash -c "</dev/tcp/127.0.0.1/${port}" >/dev/null 2>&1
}

find_browser_display() {
  local display vnc_port websocket_port

  for display in $(seq 20 99); do
    vnc_port=$((5900 + display))
    websocket_port=$((5700 + display))
    if ! port_is_open "$vnc_port" && ! port_is_open "$websocket_port"; then
      printf '%s\n' "$display"
      return
    fi
  done

  fail "unable to find free local VNC and websocket ports"
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [[ -z "$value" || "$value" == --* ]]; then
    fail "${option} requires a value"
  fi
}

CPUS=2
MEMORY_MB=4096
QEMU_FRONTEND="${OLC_QEMU_FRONTEND:-browser}"
QEMU_DISPLAY="${OLC_QEMU_DISPLAY:-}"
QEMU_SDL_VIDEO_HIGHDPI_DISABLED="${OLC_QEMU_SDL_VIDEO_HIGHDPI_DISABLED:-1}"
QEMU_GDK_SCALE="${OLC_QEMU_GDK_SCALE:-1}"
QEMU_GDK_DPI_SCALE="${OLC_QEMU_GDK_DPI_SCALE:-1}"
VM_SCREEN_OPEN_BROWSER="${OLC_VM_SCREEN_OPEN_BROWSER:-1}"
VM_SCREEN_PORT="${OLC_VM_SCREEN_PORT:-0}"
SOURCE_DIR="${OLC_SOURCE_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
VIRTIOFSD_SANDBOX="${OLC_VIRTIOFSD_SANDBOX:-none}"
KVM_DEVICE="${OLC_KVM_DEVICE:-/dev/kvm}"
SPICE_SOCKET_DIR=""
VIRTIOFS_SOCKET_DIR=""
VM_IMAGES_SOCKET_DIR=""
VM_SCREEN_LOG=""
VIRTIOFSD_PID=""
VM_IMAGES_VIRTIOFSD_PID=""
QEMU_PID=""
VIEWER_PID=""
VM_SCREEN_PID=""
SHARE_VM_IMAGES="${OLC_SHARE_VM_IMAGES:-1}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cpus)
      require_value "$1" "${2:-}"
      CPUS="$2"
      shift 2
      ;;
    --memory)
      require_value "$1" "${2:-}"
      MEMORY_MB="$2"
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

require_command qemu-system-x86_64
VIRTIOFSD="${OLC_VIRTIOFSD:-$(resolve_virtiofsd)}"
[[ -n "$VIRTIOFSD" ]] || fail_missing_virtiofsd
[[ -d "$SOURCE_DIR" ]] || fail "source directory not found: $SOURCE_DIR"

case "$QEMU_FRONTEND" in
  browser|spice|sdl|gtk)
    ;;
  *)
    fail "unsupported QEMU frontend: $QEMU_FRONTEND"
    ;;
esac

if [[ -n "$QEMU_DISPLAY" ]]; then
  QEMU_FRONTEND="direct"
elif [[ "$QEMU_FRONTEND" == "sdl" ]]; then
  QEMU_DISPLAY="sdl,gl=off"
elif [[ "$QEMU_FRONTEND" == "gtk" ]]; then
  QEMU_DISPLAY="gtk,gl=off,zoom-to-fit=off"
fi

if [[ "$QEMU_FRONTEND" == "spice" ]]; then
  require_command remote-viewer
elif [[ "$QEMU_FRONTEND" == "browser" ]]; then
  require_command node
  NOVNC_DIR="$(resolve_novnc_dir)"
  [[ -f "$NOVNC_DIR/core/rfb.js" ]] || fail "noVNC asset directory does not contain core/rfb.js: $NOVNC_DIR"
fi

if [[ ! -e "$KVM_DEVICE" && "${OLC_SKIP_KVM_CHECK:-0}" != "1" ]]; then
  fail "${KVM_DEVICE} is required"
fi

BUILD_VM_BIN="${BUILD_VM_BIN:-./build-vm}"
if [[ -n "${OLC_VM_IMAGE:-}" ]]; then
  IMAGE_PATH="$OLC_VM_IMAGE"
  [[ -f "$IMAGE_PATH" ]] || fail "OLC_VM_IMAGE does not point to a file: $IMAGE_PATH"
else
  IMAGE_PATH="$("$BUILD_VM_BIN")"
  [[ -f "$IMAGE_PATH" ]] || fail "built image not found: $IMAGE_PATH"
fi
IMAGE_DIR="$(CDPATH= cd -- "$(dirname -- "$IMAGE_PATH")" && pwd)"
IMAGE_BASENAME="$(basename -- "$IMAGE_PATH")"

echo "booting image: $IMAGE_PATH"
echo "graphical proof: Firefox launches as the in-guest UI shell"
echo "serial output: terminal"
echo "qemu frontend: $QEMU_FRONTEND"
echo "source mount: $SOURCE_DIR -> /source"
if [[ "$SHARE_VM_IMAGES" == "1" ]]; then
  echo "image mount: $IMAGE_DIR -> /vm-images"
  echo "in-guest image: /vm-images/$IMAGE_BASENAME"
fi
echo "virtiofsd sandbox: $VIRTIOFSD_SANDBOX"
if [[ "$QEMU_FRONTEND" == "browser" ]]; then
  echo "viewer: browser tab"
  echo "novnc assets: $NOVNC_DIR"
fi
if [[ -n "$QEMU_DISPLAY" ]]; then
  echo "display backend: $QEMU_DISPLAY"
fi
echo "sdl hidpi disabled: SDL_VIDEO_HIGHDPI_DISABLED=$QEMU_SDL_VIDEO_HIGHDPI_DISABLED"
echo "gtk scale: GDK_SCALE=$QEMU_GDK_SCALE GDK_DPI_SCALE=$QEMU_GDK_DPI_SCALE"

export SDL_VIDEO_HIGHDPI_DISABLED="$QEMU_SDL_VIDEO_HIGHDPI_DISABLED"
export GDK_SCALE="$QEMU_GDK_SCALE"
export GDK_DPI_SCALE="$QEMU_GDK_DPI_SCALE"

cleanup() {
  trap - EXIT INT TERM

  if [[ -n "$VIEWER_PID" ]] && kill -0 "$VIEWER_PID" >/dev/null 2>&1; then
    kill "$VIEWER_PID" >/dev/null 2>&1 || true
    wait "$VIEWER_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$QEMU_PID" ]] && kill -0 "$QEMU_PID" >/dev/null 2>&1; then
    kill "$QEMU_PID" >/dev/null 2>&1 || true
    wait "$QEMU_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$SPICE_SOCKET_DIR" ]]; then
    rm -rf "$SPICE_SOCKET_DIR"
  fi

  if [[ -n "$VM_SCREEN_PID" ]] && kill -0 "$VM_SCREEN_PID" >/dev/null 2>&1; then
    kill "$VM_SCREEN_PID" >/dev/null 2>&1 || true
    wait "$VM_SCREEN_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VM_SCREEN_LOG" ]]; then
    rm -f "$VM_SCREEN_LOG"
  fi

  if [[ -n "$VIRTIOFSD_PID" ]] && kill -0 "$VIRTIOFSD_PID" >/dev/null 2>&1; then
    kill "$VIRTIOFSD_PID" >/dev/null 2>&1 || true
    wait "$VIRTIOFSD_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VIRTIOFS_SOCKET_DIR" ]]; then
    rm -rf "$VIRTIOFS_SOCKET_DIR"
  fi

  if [[ -n "$VM_IMAGES_VIRTIOFSD_PID" ]] && kill -0 "$VM_IMAGES_VIRTIOFSD_PID" >/dev/null 2>&1; then
    kill "$VM_IMAGES_VIRTIOFSD_PID" >/dev/null 2>&1 || true
    wait "$VM_IMAGES_VIRTIOFSD_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VM_IMAGES_SOCKET_DIR" ]]; then
    rm -rf "$VM_IMAGES_SOCKET_DIR"
  fi
}

trap cleanup EXIT INT TERM

VIRTIOFS_SOCKET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ol-c-virtiofs.XXXXXX")"
VIRTIOFS_SOCKET="${VIRTIOFS_SOCKET_DIR}/source.sock"

"$VIRTIOFSD" \
  --socket-path="$VIRTIOFS_SOCKET" \
  --shared-dir="$SOURCE_DIR" \
  --sandbox="$VIRTIOFSD_SANDBOX" \
  --cache=auto &
VIRTIOFSD_PID="$!"

for _ in $(seq 1 100); do
  if [[ -S "$VIRTIOFS_SOCKET" || -e "$VIRTIOFS_SOCKET" ]]; then
    break
  fi

  if ! kill -0 "$VIRTIOFSD_PID" >/dev/null 2>&1; then
    wait "$VIRTIOFSD_PID" || true
    fail "virtiofsd exited before creating the source socket"
  fi

  sleep 0.1
done

[[ -S "$VIRTIOFS_SOCKET" || -e "$VIRTIOFS_SOCKET" ]] || fail "timed out waiting for virtiofsd socket: $VIRTIOFS_SOCKET"

vm_images_qemu_args=()
if [[ "$SHARE_VM_IMAGES" == "1" ]]; then
  VM_IMAGES_SOCKET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ol-c-vm-images.XXXXXX")"
  VM_IMAGES_SOCKET="${VM_IMAGES_SOCKET_DIR}/vm-images.sock"

  "$VIRTIOFSD" \
    --socket-path="$VM_IMAGES_SOCKET" \
    --shared-dir="$IMAGE_DIR" \
    --sandbox="$VIRTIOFSD_SANDBOX" \
    --cache=auto &
  VM_IMAGES_VIRTIOFSD_PID="$!"

  for _ in $(seq 1 100); do
    if [[ -S "$VM_IMAGES_SOCKET" || -e "$VM_IMAGES_SOCKET" ]]; then
      break
    fi

    if ! kill -0 "$VM_IMAGES_VIRTIOFSD_PID" >/dev/null 2>&1; then
      wait "$VM_IMAGES_VIRTIOFSD_PID" || true
      fail "virtiofsd exited before creating the VM images socket"
    fi

    sleep 0.1
  done

  [[ -S "$VM_IMAGES_SOCKET" || -e "$VM_IMAGES_SOCKET" ]] || fail "timed out waiting for VM images virtiofsd socket: $VM_IMAGES_SOCKET"
  vm_images_qemu_args=(
    -chardev "socket,id=ol-c-vm-images,path=${VM_IMAGES_SOCKET}"
    -device "vhost-user-fs-pci,chardev=ol-c-vm-images,tag=ol-c-vm-images"
  )
fi

qemu_base_args=(
  -enable-kvm
  -cpu host
  -smp "$CPUS"
  -m "$MEMORY_MB"
  -object "memory-backend-memfd,id=olc-mem,size=${MEMORY_MB}M,share=on"
  -numa "node,memdev=olc-mem"
  -drive "if=virtio,format=qcow2,file=$IMAGE_PATH"
  -snapshot
  -netdev user,id=olc-net
  -device virtio-net-pci,netdev=olc-net
  -chardev "socket,id=ol-c-source,path=${VIRTIOFS_SOCKET}"
  -device "vhost-user-fs-pci,chardev=ol-c-source,tag=ol-c-source"
  "${vm_images_qemu_args[@]}"
  -device virtio-rng-pci
  -device virtio-vga
  -device qemu-xhci,id=ol-c-usb
  -device usb-tablet,bus=ol-c-usb.0
  -audiodev none,id=olc-audio
  -device intel-hda
  -device hda-duplex,audiodev=olc-audio
  -serial mon:stdio
)

if [[ "$QEMU_FRONTEND" != "spice" ]]; then
  if [[ "$QEMU_FRONTEND" == "browser" ]]; then
    VNC_DISPLAY="$(find_browser_display)"
    VNC_WEBSOCKET_PORT=$((5700 + VNC_DISPLAY))
    VM_SCREEN_LOG="$(mktemp "${TMPDIR:-/tmp}/ol-c-vm-screen.XXXXXX.log")"

    echo "vnc display: 127.0.0.1:${VNC_DISPLAY}"
    echo "vnc websocket: 127.0.0.1:${VNC_WEBSOCKET_PORT}"

    qemu-system-x86_64 \
      "${qemu_base_args[@]}" \
      -display none \
      -vnc "127.0.0.1:${VNC_DISPLAY},websocket=127.0.0.1:${VNC_WEBSOCKET_PORT}" &
    QEMU_PID="$!"

    OLC_NOVNC_DIR="$NOVNC_DIR" \
    OLC_VM_SCREEN_HOST="127.0.0.1" \
    OLC_VM_SCREEN_PORT="$VM_SCREEN_PORT" \
    OLC_VM_SCREEN_VNC_HOST="127.0.0.1" \
    OLC_VM_SCREEN_VNC_WS_PORT="$VNC_WEBSOCKET_PORT" \
      node "$(dirname -- "$0")/vm-screen/server.mjs" >"$VM_SCREEN_LOG" 2>&1 &
    VM_SCREEN_PID="$!"

    for _ in $(seq 1 100); do
      if grep -q '^OLC_VM_SCREEN_URL ' "$VM_SCREEN_LOG"; then
        break
      fi

      if ! kill -0 "$VM_SCREEN_PID" >/dev/null 2>&1; then
        cat "$VM_SCREEN_LOG" >&2 || true
        wait "$VM_SCREEN_PID" || true
        fail "VM screen server exited before reporting its URL"
      fi

      sleep 0.1
    done

    if ! grep -q '^OLC_VM_SCREEN_URL ' "$VM_SCREEN_LOG"; then
      cat "$VM_SCREEN_LOG" >&2 || true
      fail "timed out waiting for VM screen server URL"
    fi

    VM_SCREEN_URL="$(sed -n 's/^OLC_VM_SCREEN_URL //p' "$VM_SCREEN_LOG" | sed -n '1p')"
    VM_SCREEN_RECONNECT_URL="${VM_SCREEN_URL/127.0.0.1/localhost}"
    echo "browser url: $VM_SCREEN_URL"
    echo "reconnect url: $VM_SCREEN_RECONNECT_URL"

    if [[ "$VM_SCREEN_OPEN_BROWSER" == "1" ]] && command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$VM_SCREEN_URL" >/dev/null 2>&1 || true
    fi

    while true; do
      EXITED_PID=""
      set +e
      wait -n -p EXITED_PID "$QEMU_PID" "$VM_SCREEN_PID"
      EXITED_STATUS="$?"
      set -e

      if [[ "$EXITED_PID" == "$QEMU_PID" ]]; then
        QEMU_PID=""
        if kill -0 "$VM_SCREEN_PID" >/dev/null 2>&1; then
          kill "$VM_SCREEN_PID" >/dev/null 2>&1 || true
          wait "$VM_SCREEN_PID" >/dev/null 2>&1 || true
          VM_SCREEN_PID=""
        fi
        exit "$EXITED_STATUS"
      fi

      if [[ "$EXITED_PID" == "$VM_SCREEN_PID" ]]; then
        VM_SCREEN_PID=""
        if kill -0 "$QEMU_PID" >/dev/null 2>&1; then
          kill "$QEMU_PID" >/dev/null 2>&1 || true
          wait "$QEMU_PID" >/dev/null 2>&1 || true
          QEMU_PID=""
        fi
        exit "$EXITED_STATUS"
      fi

      exit "$EXITED_STATUS"
    done
  fi

  qemu-system-x86_64 \
    "${qemu_base_args[@]}" \
    -display "$QEMU_DISPLAY" &
  QEMU_PID="$!"
  wait "$QEMU_PID"
  QEMU_PID=""
  exit 0
fi

SPICE_SOCKET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ol-c-spice.XXXXXX")"
SPICE_SOCKET="${SPICE_SOCKET_DIR}/spice.sock"
SPICE_URI="spice+unix://${SPICE_SOCKET}"

echo "spice socket: $SPICE_SOCKET"

qemu-system-x86_64 \
  "${qemu_base_args[@]}" \
  -display none \
  -spice "unix=on,addr=${SPICE_SOCKET},disable-ticketing=on,agent-mouse=on,gl=off" \
  -device virtio-serial-pci \
  -chardev spicevmc,id=ol-c-vdagent,name=vdagent \
  -device virtserialport,chardev=ol-c-vdagent,name=com.redhat.spice.0 &
QEMU_PID="$!"

for _ in $(seq 1 100); do
  if [[ -S "$SPICE_SOCKET" || -e "$SPICE_SOCKET" ]]; then
    break
  fi

  if ! kill -0 "$QEMU_PID" >/dev/null 2>&1; then
    wait "$QEMU_PID" || true
    fail "QEMU exited before creating the SPICE socket"
  fi

  sleep 0.1
done

[[ -S "$SPICE_SOCKET" || -e "$SPICE_SOCKET" ]] || fail "timed out waiting for SPICE socket: $SPICE_SOCKET"

echo "viewer: remote-viewer $SPICE_URI"
remote-viewer "$SPICE_URI" &
VIEWER_PID="$!"

while true; do
  EXITED_PID=""
  set +e
  wait -n -p EXITED_PID "$QEMU_PID" "$VIEWER_PID"
  EXITED_STATUS="$?"
  set -e

  if [[ "$EXITED_PID" == "$VIEWER_PID" ]]; then
    VIEWER_PID=""
    if kill -0 "$QEMU_PID" >/dev/null 2>&1; then
      kill "$QEMU_PID" >/dev/null 2>&1 || true
      wait "$QEMU_PID" >/dev/null 2>&1 || true
      QEMU_PID=""
    fi
    exit 0
  fi

  if [[ "$EXITED_PID" == "$QEMU_PID" ]]; then
    QEMU_PID=""
    if kill -0 "$VIEWER_PID" >/dev/null 2>&1; then
      kill "$VIEWER_PID" >/dev/null 2>&1 || true
      wait "$VIEWER_PID" >/dev/null 2>&1 || true
      VIEWER_PID=""
    fi
    exit "$EXITED_STATUS"
  fi

  exit "$EXITED_STATUS"
done
