#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: launch-vm [options]

Options:
  --milestone NAME  Guest profile to boot: milestone1 or milestone2. Default: milestone1.
  --cpus N          Guest vCPU count. Default: 2.
  --memory MB       Guest memory in megabytes. Default: 2048.
  --help            Show this help text.
EOF
}

fail() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "required command not found: $1"
  fi
}

PROFILE="milestone1"
CPUS=2
MEMORY_MB=2048

while [[ $# -gt 0 ]]; do
  case "$1" in
    --milestone)
      PROFILE="$2"
      shift 2
      ;;
    --cpus)
      CPUS="$2"
      shift 2
      ;;
    --memory)
      MEMORY_MB="$2"
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

case "$PROFILE" in
  milestone1|milestone2)
    ;;
  *)
    fail "unsupported milestone: $PROFILE"
    ;;
esac

require_command qemu-system-x86_64

if [[ ! -e /dev/kvm && "${SECUREOS_SKIP_KVM_CHECK:-0}" != "1" ]]; then
  fail "/dev/kvm is required for ${PROFILE}"
fi

BUILD_VM_BIN="${BUILD_VM_BIN:-./build-vm}"
IMAGE_PATH="$("$BUILD_VM_BIN" "$PROFILE")"
[[ -f "$IMAGE_PATH" ]] || fail "built image not found: $IMAGE_PATH"

if [[ "$PROFILE" == "milestone1" ]]; then
  echo "booting image: $IMAGE_PATH"
  echo "success marker: MILESTONE1_BOOT_OK"

  exec qemu-system-x86_64 \
    -enable-kvm \
    -cpu host \
    -smp "$CPUS" \
    -m "$MEMORY_MB" \
    -drive "if=virtio,format=qcow2,file=$IMAGE_PATH" \
    -nographic \
    -serial mon:stdio \
    -snapshot \
    -device virtio-rng-pci
fi

echo "booting image: $IMAGE_PATH"
echo "graphical proof: Firefox launches as the in-guest UI shell"
echo "serial output: terminal"

exec qemu-system-x86_64 \
  -enable-kvm \
  -cpu host \
  -smp "$CPUS" \
  -m "$MEMORY_MB" \
  -drive "if=virtio,format=qcow2,file=$IMAGE_PATH" \
  -snapshot \
  -device virtio-rng-pci \
  -device virtio-vga \
  -serial mon:stdio
