#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: launch-vm [options]

Options:
  --cpus N          Guest vCPU count. Default: 8.
  --memory MB       Guest memory in megabytes. Default: 16384.
  --help            Show this help text.

Environment:
  OLC_VM_IMAGE      Existing VM image to boot. Skips build-vm when set.
  OLC_VM_DISK_SIZE  Disposable overlay disk virtual size. Default: 64G.
  OLC_VM_FAST_BOOT  Tag the guest for nested fast-boot service trimming.
                    Default: 0.
  OLC_VM_NETWORK_MODE
                    Guest network mode: user or none. Default: user.
  OLC_VM_WAIT_READY Wait for a guest journald ready marker and fail on timeout.
                    Default: 0.
  OLC_VM_READY_TIMEOUT_SECONDS
                    Ready-marker failure timeout. Default: 30.
  OLC_VM_READY_WARN_SECONDS
                    Warn when the ready marker is slower than this. Default: 15.
  OLC_VM_READY_JOURNAL
                    Shared journal path for ready-marker discovery. Default:
                    <source-dir>/.olc-debug/journal.
  OLC_SHARE_VM_IMAGES
                          Mount the boot image directory at /vm-images. Default: 1.
  OLC_QEMU_BIN      QEMU executable path. Default: built from .#qemu-olc for
                    the browser viewer path.
  OLC_QEMU_PACKAGE  Nix package for browser frontend QEMU. Default: .#qemu-olc.
  OLC_NOVNC_DIR           noVNC asset directory. Default: built from .#novnc.
  OLC_VM_AUDIO_MODE       Embedded VM audio mode: browser or none.
                    Default: browser.
  OLC_VM_AUDIO_PULSE_SERVER
                    PulseAudio/PipeWire server for embedded VM audio.
                    Default: unix:/run/user/<uid>/pulse/native.
  OLC_PACTL         pactl executable path. Default: first pactl in PATH or
                    built from .#pulseaudio.
  OLC_PAREC         parec executable path. Default: first parec in PATH or
                    built from .#pulseaudio.
  OLC_VM_SCREEN_OPEN_BROWSER
                          Open the browser viewer with xdg-open. Default: 1.
  OLC_VM_SCREEN_PORT      Local browser viewer HTTP port. Default: automatic.
  OLC_SOURCE_DIR          Host source tree to mount at /source. Default: this repo.
  OLC_VIRTIOFSD           virtiofsd executable path. Default: first virtiofsd in PATH.
  OLC_VIRTIOFSD_SANDBOX   virtiofsd sandbox mode. Default: namespace when
                          host uidmap helpers are available, otherwise none.
  OLC_VIRTIOFSD_TRANSLATE_IDS
                          Map guest demo UID/GID to launcher UID/GID. Uses
                          namespace uid/gid maps by default and legacy
                          translate maps with OLC_VIRTIOFSD_SANDBOX=none.
                          Default: 1.
  OLC_VIRTIOFSD_HOST_UID  Host UID for guest demo writes. Default: id -u.
  OLC_VIRTIOFSD_HOST_GID  Host GID for guest demo writes. Default: id -g.
  OLC_KVM_DEVICE          KVM device path. Default: /dev/kvm.
  OLC_VM_PARENT_MACHINE_ID
                          Parent VM machine-id to expose to the guest for
                          nested log lineage. Default: unset.
  OLC_VM_PARENT_DEPTH
                          Parent VM nesting depth for nested log lineage.
                          Default: 0 when parent machine id is set.
  OLC_SKIP_SOURCE_WRITE_CHECK
                          Skip source directory create/delete validation. Default: 0.
EOF
}

fail() {
  echo "error: $*" >&2
  exit 1
}

fail_missing_virtiofsd() {
  cat >&2 <<'EOF'
error: required command not found: virtiofsd

Install the host virtiofs daemon, then rerun ./launch-vm.

Ubuntu:
  sudo apt update
  sudo apt install -y virtiofsd

If virtiofsd is installed in a non-standard location, set:
  OLC_VIRTIOFSD=/path/to/virtiofsd ./launch-vm
EOF
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "required command not found: $1"
  fi
}

epoch_ms() {
  local seconds micros
  IFS=. read -r seconds micros <<<"${EPOCHREALTIME:-0.000000}"
  micros="${micros:-000000}"
  printf '%s%03d\n' "$seconds" "$((10#${micros:0:3}))"
}

elapsed_ms() {
  local started_ms="$1"
  local ended_ms="${2:-$(epoch_ms)}"
  printf '%s\n' "$((ended_ms - started_ms))"
}

check_source_dir_writable() {
  local test_path test_dir

  if [[ "${OLC_SKIP_SOURCE_WRITE_CHECK:-0}" == "1" ]]; then
    return
  fi

  test_path="${SOURCE_DIR}/.olc-source-write-test.$$"
  test_dir="${SOURCE_DIR}/.olc-source-write-test-dir.$$"

  if ! : > "$test_path" 2>/dev/null; then
    fail "source directory does not allow creating files: $SOURCE_DIR. Fix host permissions or the virtiofs export before launching, or set OLC_SKIP_SOURCE_WRITE_CHECK=1 to bypass."
  fi
  rm -f "$test_path"

  if ! mkdir "$test_dir" 2>/dev/null; then
    fail "source directory does not allow creating directories: $SOURCE_DIR. Fix host permissions or the virtiofs export before launching, or set OLC_SKIP_SOURCE_WRITE_CHECK=1 to bypass."
  fi
  rmdir "$test_dir"
}

resolve_command() {
  command -v "$1" 2>/dev/null || true
}

resolve_virtiofsd() {
  local candidate

  candidate="$(resolve_command virtiofsd)"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return
  fi

  for candidate in /usr/lib/qemu/virtiofsd /usr/libexec/virtiofsd; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}

resolve_novnc_dir() {
  local out_path candidate

  if [[ -n "${OLC_NOVNC_DIR:-}" ]]; then
    RESOLVED_NOVNC_DIR="$OLC_NOVNC_DIR"
    return
  fi

  out_path="$(nix build .#novnc --print-out-paths --no-link)"
  for candidate in \
    "$out_path/share/webapps/novnc" \
    "$out_path/share/webapps/noVNC" \
    "$out_path/share/novnc" \
    "$out_path/share/noVNC" \
    "$out_path"; do
    if [[ -f "$candidate/core/rfb.js" ]]; then
      RESOLVED_NOVNC_DIR="$candidate"
      return
    fi
  done

  fail "unable to locate noVNC core/rfb.js in nix build output: $out_path"
}

resolve_qemu_binary() {
  local out_path candidate

  if [[ -n "${OLC_QEMU_BIN:-}" ]]; then
    [[ -x "$OLC_QEMU_BIN" ]] || fail "OLC_QEMU_BIN is not executable: $OLC_QEMU_BIN"
    RESOLVED_QEMU_BIN="$OLC_QEMU_BIN"
    return
  fi

  if [[ "$QEMU_FRONTEND" == "browser" ]]; then
    require_command nix
    out_path="$(nix build "${OLC_QEMU_PACKAGE:-.#qemu-olc}" --print-out-paths --no-link)"
    for candidate in \
      "$out_path/bin/qemu-system-x86_64" \
      "$out_path/bin/qemu-kvm"; do
      if [[ -x "$candidate" ]]; then
        RESOLVED_QEMU_BIN="$candidate"
        return
      fi
    done

    fail "unable to locate qemu-system-x86_64 in patched QEMU build output: $out_path"
  fi

  candidate="$(resolve_command qemu-system-x86_64)"
  [[ -n "$candidate" ]] || fail "required command not found: qemu-system-x86_64"
  RESOLVED_QEMU_BIN="$candidate"
}

resolve_pulseaudio_tool() {
  local env_name="$1"
  local tool_name="$2"
  local override="${!env_name:-}"
  local out_path candidate

  if [[ -n "$override" ]]; then
    [[ -x "$override" ]] || fail "${env_name} is not executable: $override"
    printf '%s\n' "$override"
    return
  fi

  candidate="$(resolve_command "$tool_name")"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return
  fi

  require_command nix
  out_path="$(nix build .#pulseaudio --print-out-paths --no-link)"
  candidate="$out_path/bin/$tool_name"
  [[ -x "$candidate" ]] || fail "unable to locate ${tool_name} in pulseaudio build output: $out_path"
  printf '%s\n' "$candidate"
}

setup_vm_audio() {
  local audio_args_json

  case "$VM_AUDIO_MODE" in
    none)
      AUDIO_QEMU_ARGS=(
        -audiodev none,id=olc-audio
      )
      return
      ;;
    browser)
      ;;
    *)
      fail "unsupported VM audio mode: $VM_AUDIO_MODE"
      ;;
  esac

  PACTL_BIN="$(resolve_pulseaudio_tool OLC_PACTL pactl)"
  PAREC_BIN="$(resolve_pulseaudio_tool OLC_PAREC parec)"

  if ! PULSE_SERVER="$VM_AUDIO_PULSE_SERVER" "$PACTL_BIN" info >/dev/null 2>&1; then
    fail "unable to connect to PulseAudio/PipeWire server for VM audio: $VM_AUDIO_PULSE_SERVER"
  fi

  AUDIO_SINK_NAME="olc_vm_${$}_${RANDOM}"
  AUDIO_SINK_MODULE_ID="$(
    PULSE_SERVER="$VM_AUDIO_PULSE_SERVER" \
      "$PACTL_BIN" load-module module-null-sink \
      "sink_name=$AUDIO_SINK_NAME" \
      "rate=$VM_AUDIO_SAMPLE_RATE" \
      "channels=$VM_AUDIO_CHANNELS" \
      "format=$VM_AUDIO_FORMAT"
  )"
  AUDIO_SINK_MODULE_ID="$(printf '%s' "$AUDIO_SINK_MODULE_ID" | tr -d '\n')"
  [[ "$AUDIO_SINK_MODULE_ID" =~ ^[0-9]+$ ]] || fail "failed to create VM audio bridge sink: ${AUDIO_SINK_MODULE_ID:-<empty>}"

  audio_args_json="$(printf '["--device=%s.monitor","--rate=%s","--channels=%s","--format=%s","--raw","--latency-msec=20"]' \
    "$AUDIO_SINK_NAME" \
    "$VM_AUDIO_SAMPLE_RATE" \
    "$VM_AUDIO_CHANNELS" \
    "$VM_AUDIO_FORMAT")"

  AUDIO_QEMU_ARGS=(
    -audiodev "pa,id=olc-audio,server=${VM_AUDIO_PULSE_SERVER},out.latency=20000"
  )
  AUDIO_QEMU_ENV=(
    "PULSE_SERVER=${VM_AUDIO_PULSE_SERVER}"
    "PULSE_SINK=${AUDIO_SINK_NAME}"
  )
  VM_SCREEN_AUDIO_ENV=(
    "OLC_VM_SCREEN_AUDIO_ENABLED=1"
    "OLC_VM_SCREEN_AUDIO_BIN=${PAREC_BIN}"
    "OLC_VM_SCREEN_AUDIO_ARGS_JSON=${audio_args_json}"
    "OLC_VM_SCREEN_AUDIO_SAMPLE_RATE=${VM_AUDIO_SAMPLE_RATE}"
    "OLC_VM_SCREEN_AUDIO_CHANNELS=${VM_AUDIO_CHANNELS}"
    "OLC_VM_SCREEN_AUDIO_FORMAT=${VM_AUDIO_FORMAT}"
  )
}

virtiofsd_supports_translate_ids() {
  "$VIRTIOFSD" --help 2>&1 | grep -q -- '--translate-uid' &&
    "$VIRTIOFSD" --help 2>&1 | grep -q -- '--translate-gid'
}

virtiofsd_supports_namespace_id_maps() {
  "$VIRTIOFSD" --help 2>&1 | grep -q -- '--uid-map' &&
    "$VIRTIOFSD" --help 2>&1 | grep -q -- '--gid-map'
}

virtiofsd_namespace_id_map_helpers_available() {
  command -v newuidmap >/dev/null 2>&1 &&
    command -v newgidmap >/dev/null 2>&1
}

use_virtiofsd_translate_mapping() {
  virtiofsd_id_args=(
    "--translate-uid=map:1000:${VIRTIOFSD_HOST_UID}:1"
    "--translate-gid=map:1000:${VIRTIOFSD_HOST_GID}:1"
  )
  VIRTIOFSD_ID_MAPPING_MODE="translate"
}

use_virtiofsd_namespace_mapping() {
  virtiofsd_id_args=(
    "--uid-map=:1000:${VIRTIOFSD_HOST_UID}:1:"
    "--gid-map=:1000:${VIRTIOFSD_HOST_GID}:1:"
  )
  VIRTIOFSD_ID_MAPPING_MODE="namespace"
}

virtiofsd_host_ids_match_guest() {
  [[ "$VIRTIOFSD_HOST_UID" == "1000" && "$VIRTIOFSD_HOST_GID" == "1000" ]]
}

warn_virtiofsd_unmapped_source() {
  if virtiofsd_host_ids_match_guest; then
    return
  fi
  echo "warning: virtiofsd cannot map guest UID/GID 1000:1000 to host ${VIRTIOFSD_HOST_UID}:${VIRTIOFSD_HOST_GID}; /source writes may require matching host UID/GID" >&2
}

fallback_to_virtiofsd_sandbox_none() {
  local reason="$1"

  VIRTIOFSD_SANDBOX="none"
  if virtiofsd_supports_translate_ids; then
    echo "warning: ${reason}; falling back to OLC_VIRTIOFSD_SANDBOX=none legacy translation" >&2
    use_virtiofsd_translate_mapping
  else
    if virtiofsd_host_ids_match_guest; then
      return
    fi
    echo "warning: ${reason}; falling back to OLC_VIRTIOFSD_SANDBOX=none without UID/GID translation; /source writes may require matching host UID/GID" >&2
  fi
}

start_virtiofsd() {
  local socket_path="$1"
  local shared_dir="$2"

  "$VIRTIOFSD" \
    --socket-path="$socket_path" \
    --shared-dir="$shared_dir" \
    --sandbox="$VIRTIOFSD_SANDBOX" \
    "${virtiofsd_id_args[@]}" \
    --cache=auto &
  STARTED_VIRTIOFSD_PID="$!"
}

wait_for_virtiofsd_socket() {
  local pid="$1"
  local socket_path="$2"
  local socket_label="$3"
  local timeout_message

  for _ in $(seq 1 100); do
    if [[ -S "$socket_path" || -e "$socket_path" ]]; then
      sleep 0.1
      if ! kill -0 "$pid" >/dev/null 2>&1; then
        wait "$pid" 2>/dev/null || true
        fail "virtiofsd exited after creating the ${socket_label} socket"
      fi
      return 0
    fi

    if ! kill -0 "$pid" >/dev/null 2>&1; then
      wait "$pid" 2>/dev/null || true
      fail "virtiofsd exited before creating the ${socket_label} socket"
    fi

    sleep 0.1
  done

  if [[ "$socket_label" == "source" ]]; then
    timeout_message="timed out waiting for virtiofsd socket: $socket_path"
  else
    timeout_message="timed out waiting for ${socket_label} virtiofsd socket: $socket_path"
  fi
  fail "$timeout_message"
}

port_is_open() {
  local port="$1"

  timeout 0.2 bash -c "</dev/tcp/127.0.0.1/${port}" >/dev/null 2>&1
}

find_browser_display() {
  local display vnc_port websocket_port

  for display in $(seq 20 99); do
    vnc_port=$((5900 + display))
    websocket_port=$((5700 + display))
    if ! port_is_open "$vnc_port" && ! port_is_open "$websocket_port"; then
      printf '%s\n' "$display"
      return
    fi
  done

  fail "unable to find free local VNC and websocket ports"
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [[ -z "$value" || "$value" == --* ]]; then
    fail "${option} requires a value"
  fi
}

wait_for_vm_ready() {
  local journalctl_bin parent_machine_id parent_depth expected_depth
  local journal_args=()
  local ready_started_s ready_started_ms ready_deadline_ms
  local ready_output tail_output elapsed_ms_value ready_realtime_us ready_realtime_ms
  local ready_machine_id ready_boot_id

  [[ "$VM_WAIT_READY" == "1" ]] || return 0

  journalctl_bin="$(resolve_command journalctl)"
  [[ -n "$journalctl_bin" ]] || fail "required command not found: journalctl"

  parent_machine_id="${OLC_VM_PARENT_MACHINE_ID:-}"
  parent_depth="${OLC_VM_PARENT_DEPTH:-}"
  expected_depth=""
  if [[ -n "$parent_depth" ]]; then
    expected_depth="$((parent_depth + 1))"
  fi

  ready_started_s="$(date +%s)"
  ready_started_ms="$(epoch_ms)"
  ready_deadline_ms="$((ready_started_ms + (VM_READY_TIMEOUT_SECONDS * 1000)))"
  echo "waiting for ready marker: timeout=${VM_READY_TIMEOUT_SECONDS}s warn=${VM_READY_WARN_SECONDS}s journal=${VM_READY_JOURNAL}"

  if [[ -d "$VM_READY_JOURNAL" ]]; then
    journal_args=(--directory="$VM_READY_JOURNAL")
  else
    journal_args=(--file="$VM_READY_JOURNAL")
  fi

  while (( "$(epoch_ms)" < ready_deadline_ms )); do
    if [[ ! -e "$VM_READY_JOURNAL" ]]; then
      sleep 0.1
      continue
    fi

    ready_output="$(
      "$journalctl_bin" \
        "${journal_args[@]}" \
        --since="@$ready_started_s" \
        --no-pager \
        --output=export \
        SYSLOG_IDENTIFIER=olc-vm-ready \
        OLC_VM_READY=embedded-control-ready \
        ${parent_machine_id:+"OLC_VM_PARENT_MACHINE_ID=$parent_machine_id"} \
        ${expected_depth:+"OLC_VM_DEPTH=$expected_depth"} \
        2>/dev/null || true
    )"

    if [[ -n "$ready_output" ]]; then
      ready_machine_id="$(printf '%s\n' "$ready_output" | sed -n 's/^OLC_VM_MACHINE_ID=//p' | head -n 1)"
      ready_boot_id="$(printf '%s\n' "$ready_output" | sed -n 's/^OLC_VM_BOOT_ID=//p' | head -n 1)"
      if [[ -n "$ready_machine_id" ]]; then
        VM_MACHINE_ID="$ready_machine_id"
      fi
      if [[ -n "$ready_boot_id" ]]; then
        VM_BOOT_ID="$ready_boot_id"
      fi
      ready_realtime_us="$(printf '%s\n' "$ready_output" | sed -n 's/^__REALTIME_TIMESTAMP=//p' | head -n 1)"
      if [[ -n "$ready_realtime_us" ]]; then
        ready_realtime_ms="$((ready_realtime_us / 1000))"
        elapsed_ms_value="$((ready_realtime_ms - LAUNCH_STARTED_MS))"
      else
        elapsed_ms_value="$(elapsed_ms "$LAUNCH_STARTED_MS")"
      fi
      if (( elapsed_ms_value > VM_READY_WARN_SECONDS * 1000 )); then
        echo "warning: ready marker arrived after ${elapsed_ms_value}ms (warn budget ${VM_READY_WARN_SECONDS}s)" >&2
      else
        echo "ready marker arrived after ${elapsed_ms_value}ms"
      fi
      return
    fi

    sleep 0.1
  done

  echo "error: timed out waiting ${VM_READY_TIMEOUT_SECONDS}s for embedded VM ready marker" >&2
  tail_output="$(
    "$journalctl_bin" \
      "${journal_args[@]}" \
      --since="@$ready_started_s" \
      --no-pager \
      --output=short-precise \
      ${parent_machine_id:+"OLC_VM_PARENT_MACHINE_ID=$parent_machine_id"} \
      ${expected_depth:+"OLC_VM_DEPTH=$expected_depth"} \
      2>/dev/null \
      | tail -n 40 || true
  )"
  if [[ -n "$tail_output" ]]; then
    printf '%s\n' "$tail_output" >&2
  fi
  exit 1
}

CPUS=8
MEMORY_MB=16384
LAUNCH_STARTED_MS="$(epoch_ms)"
VM_SCREEN_OPEN_BROWSER="${OLC_VM_SCREEN_OPEN_BROWSER:-1}"
VM_SCREEN_PORT="${OLC_VM_SCREEN_PORT:-0}"
SOURCE_DIR="${OLC_SOURCE_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
VM_WAIT_READY="${OLC_VM_WAIT_READY:-0}"
VM_READY_TIMEOUT_SECONDS="${OLC_VM_READY_TIMEOUT_SECONDS:-30}"
VM_READY_WARN_SECONDS="${OLC_VM_READY_WARN_SECONDS:-15}"
VM_READY_JOURNAL="${OLC_VM_READY_JOURNAL:-${SOURCE_DIR}/.olc-debug/journal}"
VIRTIOFSD_SANDBOX_EXPLICIT=0
if [[ -n "${OLC_VIRTIOFSD_SANDBOX:-}" ]]; then
  VIRTIOFSD_SANDBOX_EXPLICIT=1
fi
VIRTIOFSD_SANDBOX="${OLC_VIRTIOFSD_SANDBOX:-namespace}"
VIRTIOFSD_TRANSLATE_IDS="${OLC_VIRTIOFSD_TRANSLATE_IDS:-1}"
VIRTIOFSD_HOST_UID="${OLC_VIRTIOFSD_HOST_UID:-$(id -u)}"
VIRTIOFSD_HOST_GID="${OLC_VIRTIOFSD_HOST_GID:-$(id -g)}"
VM_AUDIO_MODE="${OLC_VM_AUDIO_MODE:-browser}"
VM_AUDIO_PULSE_SERVER="${OLC_VM_AUDIO_PULSE_SERVER:-unix:/run/user/$(id -u)/pulse/native}"
VM_AUDIO_SAMPLE_RATE=48000
VM_AUDIO_CHANNELS=2
VM_AUDIO_FORMAT="s16le"
KVM_DEVICE="${OLC_KVM_DEVICE:-/dev/kvm}"
VM_PARENT_MACHINE_ID="${OLC_VM_PARENT_MACHINE_ID:-}"
VM_PARENT_DEPTH="${OLC_VM_PARENT_DEPTH:-}"
VIRTIOFS_SOCKET_DIR=""
VM_IMAGES_SOCKET_DIR=""
VM_SCREEN_LOG=""
VIRTIOFSD_PID=""
VM_IMAGES_VIRTIOFSD_PID=""
QEMU_PID=""
VM_SCREEN_PID=""
SHARE_VM_IMAGES="${OLC_SHARE_VM_IMAGES:-1}"
VM_DISK_SIZE="${OLC_VM_DISK_SIZE:-64G}"
VM_FAST_BOOT="${OLC_VM_FAST_BOOT:-0}"
VM_NETWORK_MODE="${OLC_VM_NETWORK_MODE:-user}"
VM_DISK_OVERLAY=""
QMP_SOCKET_DIR=""
QMP_SOCKET=""
VM_SCREEN_URL=""
VM_SCREEN_RECONNECT_URL=""
RESOLVED_QEMU_BIN=""
PACTL_BIN=""
PAREC_BIN=""
STARTED_VIRTIOFSD_PID=""
VIRTIOFSD_ID_MAPPING_MODE=""
AUDIO_SINK_NAME=""
AUDIO_SINK_MODULE_ID=""
declare -a AUDIO_QEMU_ARGS=()
declare -a AUDIO_QEMU_ENV=()
declare -a VM_SCREEN_AUDIO_ENV=()
VM_MACHINE_ID=""
VM_BOOT_ID=""
RESOLVED_NOVNC_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cpus)
      require_value "$1" "${2:-}"
      CPUS="$2"
      shift 2
      ;;
    --memory)
      require_value "$1" "${2:-}"
      MEMORY_MB="$2"
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

VIRTIOFSD="${OLC_VIRTIOFSD:-$(resolve_virtiofsd)}"
[[ -n "$VIRTIOFSD" ]] || fail_missing_virtiofsd
[[ -x "$VIRTIOFSD" ]] || fail "OLC_VIRTIOFSD is not executable: $VIRTIOFSD"
[[ -d "$SOURCE_DIR" ]] || fail "source directory not found: $SOURCE_DIR"
check_source_dir_writable

virtiofsd_id_args=()
if [[ "$VIRTIOFSD_TRANSLATE_IDS" == "1" ]]; then
  case "$VIRTIOFSD_SANDBOX" in
    namespace)
      if virtiofsd_supports_namespace_id_maps && virtiofsd_namespace_id_map_helpers_available; then
        use_virtiofsd_namespace_mapping
      elif [[ "$VIRTIOFSD_SANDBOX_EXPLICIT" == "1" ]]; then
        if ! virtiofsd_supports_namespace_id_maps; then
          fail "virtiofsd does not support --uid-map/--gid-map; upgrade virtiofsd or set OLC_VIRTIOFSD_SANDBOX=none for legacy --translate-* mapping"
        fi
        fail "virtiofsd namespace UID/GID mapping requires newuidmap and newgidmap. Install the uidmap package or set OLC_VIRTIOFSD_SANDBOX=none for legacy --translate-* mapping."
      else
        if virtiofsd_supports_namespace_id_maps; then
          fallback_to_virtiofsd_sandbox_none "virtiofsd namespace UID/GID mapping requires newuidmap and newgidmap"
        else
          fallback_to_virtiofsd_sandbox_none "virtiofsd does not support --uid-map/--gid-map"
        fi
      fi
      ;;
    none)
      if virtiofsd_supports_translate_ids; then
        use_virtiofsd_translate_mapping
      else
        warn_virtiofsd_unmapped_source
      fi
      ;;
    *)
      fail "unsupported OLC_VIRTIOFSD_SANDBOX for UID/GID mapping: ${VIRTIOFSD_SANDBOX}. Use namespace or none."
      ;;
  esac
fi

case "$VM_NETWORK_MODE" in
  user|none)
    ;;
  *)
    fail "unsupported VM network mode: $VM_NETWORK_MODE"
    ;;
esac

if [[ -n "${OLC_QEMU_DISPLAY:-}" ]]; then
  fail "OLC_QEMU_DISPLAY is not supported. launch-vm renders VMs in the browser only."
fi

if [[ -n "${OLC_QEMU_FRONTEND:-}" && "${OLC_QEMU_FRONTEND}" != "browser" ]]; then
  fail "OLC_QEMU_FRONTEND=${OLC_QEMU_FRONTEND} is not supported. launch-vm renders VMs in the browser only."
fi

QEMU_FRONTEND="browser"
require_command node
resolve_novnc_dir
NOVNC_DIR="$RESOLVED_NOVNC_DIR"
[[ -f "$NOVNC_DIR/core/rfb.js" ]] || fail "noVNC asset directory does not contain core/rfb.js: $NOVNC_DIR"

resolve_qemu_binary
QEMU_BIN="$RESOLVED_QEMU_BIN"
setup_vm_audio

if [[ ! -e "$KVM_DEVICE" && "${OLC_SKIP_KVM_CHECK:-0}" != "1" ]]; then
  fail "${KVM_DEVICE} is required"
fi

BUILD_VM_BIN="${BUILD_VM_BIN:-./build-vm}"
if [[ -n "${OLC_VM_IMAGE:-}" ]]; then
  IMAGE_PATH="$OLC_VM_IMAGE"
  [[ -f "$IMAGE_PATH" ]] || fail "OLC_VM_IMAGE does not point to a file: $IMAGE_PATH"
else
  IMAGE_PATH="$("$BUILD_VM_BIN")"
  [[ -f "$IMAGE_PATH" ]] || fail "built image not found: $IMAGE_PATH"
fi
IMAGE_DIR="$(CDPATH= cd -- "$(dirname -- "$IMAGE_PATH")" && pwd)"
IMAGE_BASENAME="$(basename -- "$IMAGE_PATH")"

require_command qemu-img
VM_DISK_OVERLAY="$(mktemp "${TMPDIR:-/tmp}/ol-c-disk.XXXXXX.qcow2")"
rm -f "$VM_DISK_OVERLAY"
qemu-img create -q \
  -f qcow2 \
  -F qcow2 \
  -b "$IMAGE_PATH" \
  "$VM_DISK_OVERLAY" \
  "$VM_DISK_SIZE"

echo "booting image: $IMAGE_PATH"
echo "runtime disk overlay: $VM_DISK_OVERLAY"
echo "runtime disk size: $VM_DISK_SIZE"
echo "fast boot: $VM_FAST_BOOT"
echo "network mode: $VM_NETWORK_MODE"
echo "graphical proof: Firefox launches as the in-guest UI shell"
echo "serial output: terminal"
echo "qemu frontend: $QEMU_FRONTEND"
echo "qemu binary: $QEMU_BIN"
QMP_SOCKET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ol-c-qmp.XXXXXX")"
QMP_SOCKET="${QMP_SOCKET_DIR}/qmp.sock"
echo "qmp socket: $QMP_SOCKET"
echo "source mount: $SOURCE_DIR -> /source"
if [[ "$SHARE_VM_IMAGES" == "1" ]]; then
  echo "image mount: $IMAGE_DIR -> /vm-images"
  echo "in-guest image: /vm-images/$IMAGE_BASENAME"
fi
echo "virtiofsd sandbox: $VIRTIOFSD_SANDBOX"
case "$VIRTIOFSD_ID_MAPPING_MODE" in
  namespace)
    echo "virtiofsd id mapping: namespace guest 1000:1000 -> host ${VIRTIOFSD_HOST_UID}:${VIRTIOFSD_HOST_GID}"
    ;;
  translate)
    echo "virtiofsd id mapping: translate guest 1000:1000 -> host ${VIRTIOFSD_HOST_UID}:${VIRTIOFSD_HOST_GID}"
    ;;
esac
echo "viewer: browser tab"
if [[ "$VM_AUDIO_MODE" == "browser" ]]; then
  echo "audio: browser bridge via ${AUDIO_SINK_NAME}.monitor"
else
  echo "audio: disabled"
fi
echo "novnc assets: $NOVNC_DIR"

cleanup() {
  local exit_status="$?"
  trap - EXIT INT TERM

  if [[ -n "$QEMU_PID" ]] && kill -0 "$QEMU_PID" >/dev/null 2>&1; then
    kill "$QEMU_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VM_SCREEN_PID" ]] && kill -0 "$VM_SCREEN_PID" >/dev/null 2>&1; then
    kill "$VM_SCREEN_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$AUDIO_SINK_MODULE_ID" && -n "$PACTL_BIN" ]]; then
    PULSE_SERVER="$VM_AUDIO_PULSE_SERVER" "$PACTL_BIN" unload-module "$AUDIO_SINK_MODULE_ID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VM_SCREEN_LOG" ]]; then
    rm -f "$VM_SCREEN_LOG"
  fi
  if [[ -n "$VM_DISK_OVERLAY" ]]; then
    rm -f "$VM_DISK_OVERLAY"
  fi
  if [[ -n "$QMP_SOCKET_DIR" ]]; then
    rm -rf "$QMP_SOCKET_DIR"
  fi

  if [[ -n "$VIRTIOFSD_PID" ]] && kill -0 "$VIRTIOFSD_PID" >/dev/null 2>&1; then
    kill "$VIRTIOFSD_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VIRTIOFS_SOCKET_DIR" ]]; then
    rm -rf "$VIRTIOFS_SOCKET_DIR"
  fi

  if [[ -n "$VM_IMAGES_VIRTIOFSD_PID" ]] && kill -0 "$VM_IMAGES_VIRTIOFSD_PID" >/dev/null 2>&1; then
    kill "$VM_IMAGES_VIRTIOFSD_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "$VM_IMAGES_SOCKET_DIR" ]]; then
    rm -rf "$VM_IMAGES_SOCKET_DIR"
  fi

  exit "$exit_status"
}

trap cleanup EXIT INT TERM

VIRTIOFS_SOCKET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ol-c-virtiofs.XXXXXX")"
VIRTIOFS_SOCKET="${VIRTIOFS_SOCKET_DIR}/source.sock"

start_virtiofsd "$VIRTIOFS_SOCKET" "$SOURCE_DIR"
VIRTIOFSD_PID="$STARTED_VIRTIOFSD_PID"
wait_for_virtiofsd_socket "$VIRTIOFSD_PID" "$VIRTIOFS_SOCKET" "source"

vm_images_qemu_args=()
if [[ "$SHARE_VM_IMAGES" == "1" ]]; then
  VM_IMAGES_SOCKET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ol-c-vm-images.XXXXXX")"
  VM_IMAGES_SOCKET="${VM_IMAGES_SOCKET_DIR}/vm-images.sock"

  start_virtiofsd "$VM_IMAGES_SOCKET" "$IMAGE_DIR"
  VM_IMAGES_VIRTIOFSD_PID="$STARTED_VIRTIOFSD_PID"
  wait_for_virtiofsd_socket "$VM_IMAGES_VIRTIOFSD_PID" "$VM_IMAGES_SOCKET" "VM images"
  vm_images_qemu_args=(
    -chardev "socket,id=ol-c-vm-images,path=${VM_IMAGES_SOCKET}"
    -device "vhost-user-fs-pci,chardev=ol-c-vm-images,tag=ol-c-vm-images"
  )
fi

qemu_base_args=(
  -machine pc,vmport=off,i8042=off
  -enable-kvm
  -cpu host
  -smp "$CPUS"
  -m "$MEMORY_MB"
  -object "memory-backend-memfd,id=olc-mem,size=${MEMORY_MB}M,share=on"
  -numa "node,memdev=olc-mem"
  -drive "if=virtio,format=qcow2,file=$VM_DISK_OVERLAY"
  -chardev "socket,id=ol-c-source,path=${VIRTIOFS_SOCKET}"
  -device "vhost-user-fs-pci,chardev=ol-c-source,tag=ol-c-source"
  "${vm_images_qemu_args[@]}"
  -device virtio-rng-pci
  -device virtio-vga
  -device qemu-xhci,id=ol-c-usb
  -device usb-kbd,bus=ol-c-usb.0
  -device usb-tablet,bus=ol-c-usb.0
  "${AUDIO_QEMU_ARGS[@]}"
  -device intel-hda
  -device hda-duplex,audiodev=olc-audio
  -serial mon:stdio
)

if [[ "$VM_NETWORK_MODE" == "user" ]]; then
  qemu_base_args+=(
    -netdev user,id=olc-net
    -device virtio-net-pci,netdev=olc-net
  )
fi

smbios_serial_fields=()
if [[ -n "$VM_PARENT_MACHINE_ID" ]]; then
  smbios_serial_fields+=(
    "olc-parent-machine-id=${VM_PARENT_MACHINE_ID}"
    "olc-parent-depth=${VM_PARENT_DEPTH:-0}"
  )
  echo "parent machine id: $VM_PARENT_MACHINE_ID"
  echo "parent vm depth: ${VM_PARENT_DEPTH:-0}"
fi
if [[ "$VM_FAST_BOOT" == "1" ]]; then
  smbios_serial_fields+=("olc-fast-boot=1")
fi
if [[ "$VM_NETWORK_MODE" != "user" ]]; then
  smbios_serial_fields+=("olc-net=${VM_NETWORK_MODE}")
fi
if [[ "${#smbios_serial_fields[@]}" -gt 0 ]]; then
  serial_payload="$(IFS=';'; printf '%s' "${smbios_serial_fields[*]}")"
  qemu_base_args+=(
    -smbios "type=1,serial=${serial_payload}"
  )
fi

VNC_DISPLAY="$(find_browser_display)"
VNC_WEBSOCKET_PORT=$((5700 + VNC_DISPLAY))
VM_SCREEN_LOG="$(mktemp "${TMPDIR:-/tmp}/ol-c-vm-screen.XXXXXX.log")"

echo "vnc display: 127.0.0.1:${VNC_DISPLAY}"
echo "vnc websocket: 127.0.0.1:${VNC_WEBSOCKET_PORT}"
env "${AUDIO_QEMU_ENV[@]}" "$QEMU_BIN" \
  "${qemu_base_args[@]}" \
  -qmp "unix:${QMP_SOCKET},server=on,wait=off" \
  -display none \
  -chardev qemu-vdagent,id=ol-c-vdagent,name=vdagent,clipboard=on,mouse=off \
  -device virtio-serial-pci \
  -device virtserialport,chardev=ol-c-vdagent,name=com.redhat.spice.0 \
  -vnc "127.0.0.1:${VNC_DISPLAY},websocket=127.0.0.1:${VNC_WEBSOCKET_PORT}" &
QEMU_PID="$!"

env \
  OLC_NOVNC_DIR="$NOVNC_DIR" \
  OLC_VM_SCREEN_HOST="127.0.0.1" \
  OLC_VM_SCREEN_PORT="$VM_SCREEN_PORT" \
  OLC_VM_SCREEN_VNC_HOST="127.0.0.1" \
  OLC_VM_SCREEN_VNC_WS_PORT="$VNC_WEBSOCKET_PORT" \
  PULSE_SERVER="$VM_AUDIO_PULSE_SERVER" \
  "${VM_SCREEN_AUDIO_ENV[@]}" \
  node "$(dirname -- "$0")/vm-screen/server.mjs" >"$VM_SCREEN_LOG" 2>&1 &
VM_SCREEN_PID="$!"

for _ in $(seq 1 100); do
  if grep -q '^OLC_VM_SCREEN_URL ' "$VM_SCREEN_LOG"; then
    break
  fi

  if ! kill -0 "$VM_SCREEN_PID" >/dev/null 2>&1; then
    wait "$VM_SCREEN_PID" 2>/dev/null || true
    if grep -q '^OLC_VM_SCREEN_URL ' "$VM_SCREEN_LOG"; then
      break
    fi
    cat "$VM_SCREEN_LOG" >&2 || true
    fail "VM screen server exited before reporting its URL"
  fi

  sleep 0.1
done

if ! grep -q '^OLC_VM_SCREEN_URL ' "$VM_SCREEN_LOG"; then
  cat "$VM_SCREEN_LOG" >&2 || true
  fail "timed out waiting for VM screen server URL"
fi

VM_SCREEN_URL="$(sed -n 's/^OLC_VM_SCREEN_URL //p' "$VM_SCREEN_LOG" | sed -n '1p')"
VM_SCREEN_RECONNECT_URL="${VM_SCREEN_URL/127.0.0.1/localhost}"
echo "browser url: $VM_SCREEN_URL"
echo "reconnect url: $VM_SCREEN_RECONNECT_URL"
wait_for_vm_ready

if [[ "$VM_SCREEN_OPEN_BROWSER" == "1" ]] && command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$VM_SCREEN_URL" >/dev/null 2>&1 || true
fi

while true; do
  EXITED_PID=""
  set +e
  wait -n -p EXITED_PID "$QEMU_PID" "$VM_SCREEN_PID"
  EXITED_STATUS="$?"
  set -e

  if [[ "$EXITED_PID" == "$QEMU_PID" ]]; then
    QEMU_PID=""
    if kill -0 "$VM_SCREEN_PID" >/dev/null 2>&1; then
      kill "$VM_SCREEN_PID" >/dev/null 2>&1 || true
      VM_SCREEN_PID=""
    fi
    exit "$EXITED_STATUS"
  fi

  if [[ "$EXITED_PID" == "$VM_SCREEN_PID" ]]; then
    VM_SCREEN_PID=""
    if [[ -n "$VM_SCREEN_LOG" && -s "$VM_SCREEN_LOG" ]]; then
      cat "$VM_SCREEN_LOG" >&2 || true
    fi
    if kill -0 "$QEMU_PID" >/dev/null 2>&1; then
      kill "$QEMU_PID" >/dev/null 2>&1 || true
      QEMU_PID=""
    fi
    exit "$EXITED_STATUS"
  fi

  exit "$EXITED_STATUS"
done
