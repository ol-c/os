#!/usr/bin/env bash
set -euo pipefail

DEFAULT_TARGET=".#firefox-localhost"
DEFAULT_BUCKET_SUFFIX="ol-c-remote-builds"
DEFAULT_LOCATION="us-central1"
DEFAULT_ZONE="us-central1-a"
DEFAULT_MACHINE_TYPE="h4d-standard-192"
DEFAULT_BOOT_DISK_TYPE="hyperdisk-balanced"
DEFAULT_BOOT_DISK_SIZE="300GB"
DEFAULT_TIMEOUT="1h"

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
LOCAL_BUILDS_DIR="${OLC_GCP_LOCAL_BUILDS_DIR:-${ROOT_DIR}/.gcp-builds}"
RESULT_LINK="${OLC_GCP_RESULT_LINK:-${ROOT_DIR}/result-gcp-firefox-localhost}"

usage() {
  cat <<'USAGE'
Usage:
  build-firefox-remote [TARGET]
  build-firefox-remote --dry-run [TARGET]
  build-firefox-remote --logs JOB_ID
  build-firefox-remote --status JOB_ID
  build-firefox-remote --fetch JOB_ID
  build-firefox-remote --kill JOB_ID
  build-firefox-remote --cleanup JOB_ID

Builds the current repo on a directly managed Google Compute Engine VM and
imports the resulting Nix closure locally. TARGET defaults to .#firefox-localhost.

Environment overrides:
  OLC_GCP_PROJECT
  OLC_GCP_BUCKET            default: <project-id>-ol-c-remote-builds
  OLC_GCP_LOCATION          default: us-central1
  OLC_GCP_ZONE              default: us-central1-a
  OLC_GCP_MACHINE_TYPE      default: h4d-standard-192
  OLC_GCP_BOOT_DISK_TYPE    default: hyperdisk-balanced
  OLC_GCP_BOOT_DISK_SIZE    default: 300GB
  OLC_GCP_TIMEOUT           default: 1h
  OLC_GCP_LOCAL_BUILDS_DIR  default: <repo>/.gcp-builds
  OLC_GCP_RESULT_LINK       default: <repo>/result-gcp-firefox-localhost
USAGE
}

fail() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "required command not found: $1"
  fi
}

gcloud_quiet() {
  gcloud --quiet "$@"
}

config_value() {
  gcloud config get-value "$1" 2>/dev/null || true
}

active_account() {
  gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | sed -n '1p'
}

active_configuration() {
  gcloud config configurations list --filter=is_active:true --format='value(name)' 2>/dev/null | sed -n '1p'
}

stdin_is_interactive() {
  [[ -t 0 || "${OLC_GCP_ASSUME_INTERACTIVE:-0}" == "1" ]]
}

identity_confirmation_is_interactive() {
  [[ -t 0 || "${OLC_GCP_CONFIRM_IDENTITY:-0}" == "1" ]]
}

normalize_disk_size_gb() {
  local size="$1"
  case "$size" in
    *GB)
      printf '%s\n' "${size%GB}"
      ;;
    *G)
      printf '%s\n' "${size%G}"
      ;;
    *)
      printf '%s\n' "$size"
      ;;
  esac
}

timeout_to_seconds() {
  local timeout="$1"
  case "$timeout" in
    *h)
      printf '%s\n' "$((${timeout%h} * 3600))"
      ;;
    *m)
      printf '%s\n' "$((${timeout%m} * 60))"
      ;;
    *s)
      printf '%s\n' "${timeout%s}"
      ;;
    *)
      printf '%s\n' "$timeout"
      ;;
  esac
}

confirm_gcloud_identity() {
  local choice selected_account selected_config selected_project

  if ! identity_confirmation_is_interactive || [[ "${OLC_GCP_SKIP_IDENTITY_CONFIRM:-0}" == "1" ]]; then
    return
  fi

  while true; do
    echo "Google Cloud launch identity:"
    echo "  configuration: $(active_configuration)"
    echo "  account:       $(active_account)"
    echo "  project:       ${OLC_GCP_PROJECT:-$(config_value project)}"
    echo
    read -r -p "Continue with this identity? [Y]es, [a]ccount, [l]ogin, [c]onfig, [p]roject: " choice
    case "${choice:-y}" in
      y|Y|yes|YES)
        echo
        return
        ;;
      a|A|account|ACCOUNT)
        echo "Credentialed Google Cloud accounts:"
        gcloud auth list || true
        read -r -p "Account to activate: " selected_account
        [[ -n "$selected_account" ]] || fail "account is required"
        gcloud config set account "$selected_account"
        ;;
      l|L|login|LOGIN)
        gcloud auth login --launch-browser
        ;;
      c|C|config|CONFIG)
        echo "Available Google Cloud configurations:"
        gcloud config configurations list || true
        read -r -p "Configuration to activate: " selected_config
        [[ -n "$selected_config" ]] || fail "configuration name is required"
        gcloud config configurations activate "$selected_config"
        ;;
      p|P|project|PROJECT)
        echo "Available Google Cloud projects:"
        gcloud projects list || true
        read -r -p "Project ID to use: " selected_project
        [[ -n "$selected_project" ]] || fail "project ID is required"
        gcloud config set project "$selected_project"
        ;;
      *)
        echo "Choose yes, account, login, config, or project."
        ;;
    esac
    echo
  done
}

print_gcloud_context() {
  local project="$1" location="$2" zone="$3" bucket="$4" target="$5" machine_type="$6" timeout="$7"

  echo "Google Cloud configurations:"
  gcloud config configurations list || true
  echo
  echo "Google Cloud auth accounts:"
  gcloud auth list || true
  echo
  echo "Selected remote build settings:"
  echo "  account:      $(active_account)"
  echo "  project:      $project"
  echo "  location:     $location"
  echo "  zone:         $zone"
  echo "  bucket:       gs://$bucket"
  echo "  target:       $target"
  echo "  machine:      $machine_type"
  echo "  timeout:      $timeout"
  echo
}

resolve_settings() {
  local allow_guidance="${1:-0}" account selected_project

  PROJECT="${OLC_GCP_PROJECT:-$(config_value project)}"
  BUCKET="${OLC_GCP_BUCKET:-}"
  LOCATION="${OLC_GCP_LOCATION:-$DEFAULT_LOCATION}"
  ZONE="${OLC_GCP_ZONE:-$DEFAULT_ZONE}"
  MACHINE_TYPE="${OLC_GCP_MACHINE_TYPE:-$DEFAULT_MACHINE_TYPE}"
  BOOT_DISK_TYPE="${OLC_GCP_BOOT_DISK_TYPE:-$DEFAULT_BOOT_DISK_TYPE}"
  BOOT_DISK_SIZE="${OLC_GCP_BOOT_DISK_SIZE:-$DEFAULT_BOOT_DISK_SIZE}"
  TIMEOUT="${OLC_GCP_TIMEOUT:-$DEFAULT_TIMEOUT}"
  BOOT_DISK_SIZE_GB="$(normalize_disk_size_gb "$BOOT_DISK_SIZE")"
  TIMEOUT_SECONDS="$(timeout_to_seconds "$TIMEOUT")"

  account="$(active_account)"
  if [[ -z "$account" ]]; then
    if [[ "$allow_guidance" == "1" ]]; then
      echo "No active Google Cloud account found. Launching browser login..."
      gcloud auth login --launch-browser || true
      account="$(active_account)"
    fi
    [[ -n "$account" ]] || fail "no active Google Cloud account; run: gcloud auth login --launch-browser"
  fi

  if [[ -z "$PROJECT" ]]; then
    if [[ "$allow_guidance" == "1" ]]; then
      echo "No Google Cloud project is selected."
      echo "Available projects:"
      gcloud projects list || true
      echo
      if stdin_is_interactive; then
        read -r -p "Project ID to use: " selected_project
        [[ -n "$selected_project" ]] || fail "project ID is required"
        PROJECT="$selected_project"
        if [[ -z "${OLC_GCP_PROJECT:-}" ]]; then
          gcloud config set project "$PROJECT"
        fi
      else
        fail "no Google Cloud project selected; run: gcloud config set project PROJECT_ID"
      fi
    else
      fail "no Google Cloud project selected; run: gcloud config set project PROJECT_ID"
    fi
  fi

  if [[ -z "$BUCKET" ]]; then
    BUCKET="${PROJECT}-${DEFAULT_BUCKET_SUFFIX}"
  fi
}

ensure_bucket() {
  local bucket="$1" location="$2"

  if gcloud storage buckets describe "gs://${bucket}" >/dev/null 2>&1; then
    return
  fi

  echo "Creating staging bucket gs://${bucket}"
  if ! gcloud_quiet storage buckets create "gs://${bucket}" \
    --location="$location" \
    --uniform-bucket-level-access \
    --public-access-prevention; then
    fail "unable to create gs://${bucket}; bucket names are global, so try: OLC_GCP_BUCKET=<unique-name> $0"
  fi
}

make_source_archive() {
  local archive="$1"

  tar -czf "$archive" \
    --exclude='./.git' \
    --exclude='./.codex-home' \
    --exclude='./.tmp-tests' \
    --exclude='./.gcp-builds' \
    --exclude='./terminal-client/node_modules' \
    --exclude='./result' \
    --exclude='./result-*' \
    -C "$ROOT_DIR" .
}

startup_script() {
  cat <<'STARTUP'
#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '[ol-c-remote] %s\n' "$*"
}

upload_if_exists() {
  local path="$1" name="$2"
  if [[ -e "$path" ]]; then
    gcloud --quiet storage cp "$path" "${RUN_URI}/${name}" || true
  fi
}

finish_with_status() {
  local status="$1"
  printf '%s\n' "$status" >/tmp/ol-c-status.txt
  upload_if_exists /tmp/ol-c-build.log build.log
  upload_if_exists /tmp/ol-c-status.txt status.txt
  return 0
}

self_delete_or_shutdown() {
  log "requesting VM cleanup"
  if [[ -n "${INSTANCE_NAME:-}" && -n "${PROJECT:-}" && -n "${ZONE:-}" ]]; then
    gcloud --quiet compute instances delete "$INSTANCE_NAME" \
      --project="$PROJECT" \
      --zone="$ZONE" || true
  fi
  shutdown -h now || true
}

trap 'status=$?; finish_with_status "$status"; exit "$status"' ERR

exec > >(tee /tmp/ol-c-build.log) 2>&1

export DEBIAN_FRONTEND=noninteractive

log "installing host tools"
apt-get update
apt-get install -y ca-certificates curl gnupg tar gzip xz-utils

log "installing Google Cloud CLI"
install -d -m 0755 /usr/share/keyrings
curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
  | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg
printf 'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main\n' \
  >/etc/apt/sources.list.d/google-cloud-sdk.list
apt-get update
apt-get install -y google-cloud-cli

log "installing Nix"
mkdir -p /etc/nix
cat >/etc/nix/nix.conf <<'NIXCONF'
experimental-features = nix-command flakes
trusted-users = root
max-jobs = auto
cores = 0
NIXCONF
curl -fsSL https://nixos.org/nix/install | sh -s -- --daemon --yes
set +u
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
set -u

log "downloading source archive from ${SOURCE_URI}"
mkdir -p /work/source
gcloud --quiet storage cp "$SOURCE_URI" /tmp/ol-c-source.tar.gz
tar -xzf /tmp/ol-c-source.tar.gz -C /work/source

log "building ${BUILD_TARGET}"
cd /work/source
set +e
timeout "$TIMEOUT_SECONDS" nix build "$BUILD_TARGET" --print-build-logs --out-link /tmp/ol-c-result
build_status="$?"
set -e
if [[ "$build_status" -ne 0 ]]; then
  log "build failed with status ${build_status}"
  finish_with_status "$build_status"
  self_delete_or_shutdown
  exit "$build_status"
fi

remote_out="$(readlink -f /tmp/ol-c-result)"
printf '%s\n' "$remote_out" >/tmp/ol-c-result-path.txt
printf '%s\n' "$BUILD_TARGET" >/tmp/ol-c-target.txt
printf '%s\n' 0 >/tmp/ol-c-status.txt

log "exporting Nix closure ${remote_out}"
nix copy --to file:///tmp/ol-c-nix-cache "$remote_out"
tar -C /tmp -czf /tmp/ol-c-nix-cache.tar.gz ol-c-nix-cache

log "uploading result artifacts to ${RUN_URI}"
gcloud --quiet storage cp /tmp/ol-c-nix-cache.tar.gz "${RUN_URI}/ol-c-nix-cache.tar.gz"
gcloud --quiet storage cp /tmp/ol-c-result-path.txt "${RUN_URI}/result-path.txt"
gcloud --quiet storage cp /tmp/ol-c-target.txt "${RUN_URI}/target.txt"
gcloud --quiet storage cp /tmp/ol-c-status.txt "${RUN_URI}/status.txt"
gcloud --quiet storage cp /tmp/ol-c-build.log "${RUN_URI}/build.log"

log "build complete: ${remote_out}"
self_delete_or_shutdown
STARTUP
}

write_startup_script() {
  local path="$1" target="$2" source_uri="$3" run_uri="$4" instance_name="$5"

  {
    printf 'export BUILD_TARGET="%s"\n' "$(printf '%s' "$target" | sed 's/"/\\"/g')"
    printf 'export SOURCE_URI="%s"\n' "$(printf '%s' "$source_uri" | sed 's/"/\\"/g')"
    printf 'export RUN_URI="%s"\n' "$(printf '%s' "$run_uri" | sed 's/"/\\"/g')"
    printf 'export PROJECT="%s"\n' "$(printf '%s' "$PROJECT" | sed 's/"/\\"/g')"
    printf 'export ZONE="%s"\n' "$(printf '%s' "$ZONE" | sed 's/"/\\"/g')"
    printf 'export INSTANCE_NAME="%s"\n' "$(printf '%s' "$instance_name" | sed 's/"/\\"/g')"
    printf 'export TIMEOUT_SECONDS="%s"\n' "$(printf '%s' "$TIMEOUT_SECONDS" | sed 's/"/\\"/g')"
    startup_script
  } >"$path"
}

run_prefix() {
  local job_id="$1"
  printf 'gs://%s/runs/%s' "$BUCKET" "$job_id"
}

instance_state() {
  local job_id="$1"
  gcloud compute instances describe "$job_id" \
    --project="$PROJECT" \
    --zone="$ZONE" \
    --format='value(status)' 2>/dev/null || true
}

print_serial_output() {
  local job_id="$1"
  gcloud compute instances get-serial-port-output "$job_id" \
    --project="$PROJECT" \
    --zone="$ZONE" \
    --port=1 2>/dev/null || true
}

status_artifact() {
  local job_id="$1" tmp
  tmp="$(mktemp)"
  if gcloud_quiet storage cp "$(run_prefix "$job_id")/status.txt" "$tmp" >/dev/null 2>&1; then
    sed -n '1p' "$tmp"
    rm -f "$tmp"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

wait_for_job() {
  local job_id="$1" deadline now state remote_status
  deadline=$(($(date +%s) + TIMEOUT_SECONDS + 600))

  while true; do
    remote_status="$(status_artifact "$job_id" || true)"
    if [[ "$remote_status" == "0" ]]; then
      echo "Remote build ${job_id} succeeded"
      return 0
    elif [[ -n "$remote_status" ]]; then
      echo "Remote build ${job_id} failed with status ${remote_status}" >&2
      return 1
    fi

    state="$(instance_state "$job_id")"
    case "$state" in
      "")
        echo "Waiting for VM ${job_id}; instance not found yet or already deleted"
        ;;
      TERMINATED|STOPPING|SUSPENDED)
        echo "VM ${job_id} ended with state ${state}; waiting for uploaded status"
        ;;
      *)
        echo "Waiting for VM ${job_id}; state=${state}"
        ;;
    esac

    now="$(date +%s)"
    if (( now >= deadline )); then
      echo "Timed out waiting for uploaded status. Compute Engine max-run-duration should delete the VM; deleting now if still present." >&2
      gcloud_quiet compute instances delete "$job_id" \
        --project="$PROJECT" \
        --zone="$ZONE" || true
      return 1
    fi
    sleep 30
  done
}

fetch_result() {
  local job_id="$1" dir cache_archive cache_dir remote_out target

  mkdir -p "$LOCAL_BUILDS_DIR"
  dir="${LOCAL_BUILDS_DIR}/${job_id}"
  cache_archive="${dir}/ol-c-nix-cache.tar.gz"
  cache_dir="${dir}/ol-c-nix-cache"
  mkdir -p "$dir"

  echo "Downloading artifacts for ${job_id}"
  gcloud_quiet storage cp "$(run_prefix "$job_id")/result-path.txt" "${dir}/result-path.txt"
  gcloud_quiet storage cp "$(run_prefix "$job_id")/target.txt" "${dir}/target.txt"
  gcloud_quiet storage cp "$(run_prefix "$job_id")/build.log" "${dir}/build.log" || true
  gcloud_quiet storage cp "$(run_prefix "$job_id")/ol-c-nix-cache.tar.gz" "$cache_archive"

  rm -rf "$cache_dir"
  tar -xzf "$cache_archive" -C "$dir"

  remote_out="$(sed -n '1p' "${dir}/result-path.txt")"
  target="$(sed -n '1p' "${dir}/target.txt")"

  if command -v nix >/dev/null 2>&1; then
    echo "Importing ${remote_out} into the local Nix store"
    nix copy --no-check-sigs --from "file://${cache_dir}" "$remote_out"
    if [[ "$target" == "$DEFAULT_TARGET" ]]; then
      ln -sfn "$remote_out" "$RESULT_LINK"
    fi
  else
    echo "Local nix not found; downloaded cache archive but did not import it."
    echo "After installing nix, run:"
    echo "  nix copy --from file://${cache_dir} ${remote_out}"
  fi

  echo
  echo "Remote result: ${remote_out}"
  echo "Local artifacts: ${dir}"
  echo "Cleanup GCS artifacts when done:"
  echo "  $0 --cleanup ${job_id}"
}

submit_build() {
  local target="$1" dry_run="$2"
  local job_id tmpdir archive startup source_uri run_uri

  job_id="ol-c-firefox-$(date -u +%Y%m%d-%H%M%S)-$$"
  tmpdir="$(mktemp -d)"
  archive="${tmpdir}/source.tar.gz"
  startup="${tmpdir}/startup.sh"
  run_uri="$(run_prefix "$job_id")"
  source_uri="${run_uri}/source.tar.gz"

  print_gcloud_context "$PROJECT" "$LOCATION" "$ZONE" "$BUCKET" "$target" "$MACHINE_TYPE" "$TIMEOUT"
  if ! command -v nix >/dev/null 2>&1; then
    echo "warning: local nix not found; the remote build can run, but automatic local import will be skipped during fetch" >&2
    echo
  fi

  echo "Creating source archive"
  make_source_archive "$archive"
  write_startup_script "$startup" "$target" "$source_uri" "$run_uri" "$job_id"

  if [[ "$dry_run" == "1" ]]; then
    echo "Dry run only. Would upload:"
    echo "  $archive -> $source_uri"
    echo "Would create Compute Engine VM:"
    printf '  gcloud compute instances create %s --project=%s --zone=%s --machine-type=%s --boot-disk-type=%s --boot-disk-size=%s --image-family=ubuntu-2404-lts-amd64 --image-project=ubuntu-os-cloud --scopes=https://www.googleapis.com/auth/cloud-platform --metadata-from-file=startup-script=%s --maintenance-policy=TERMINATE --max-run-duration=%s --instance-termination-action=DELETE --labels=ol-c-purpose=firefox-remote-build,ol-c-job=%s\n' \
      "$job_id" "$PROJECT" "$ZONE" "$MACHINE_TYPE" "$BOOT_DISK_TYPE" "$BOOT_DISK_SIZE" "$startup" "$TIMEOUT" "$job_id"
    echo
    echo "Startup script:"
    sed -n '1,260p' "$startup"
    rm -rf "$tmpdir"
    return
  fi

  ensure_bucket "$BUCKET" "$LOCATION"

  echo "Uploading source archive to ${source_uri}"
  gcloud_quiet storage cp "$archive" "$source_uri"

  echo "Creating Compute Engine VM ${job_id}"
  if ! gcloud compute instances create "$job_id" \
    --project="$PROJECT" \
    --zone="$ZONE" \
    --machine-type="$MACHINE_TYPE" \
    --boot-disk-type="$BOOT_DISK_TYPE" \
    --boot-disk-size="$BOOT_DISK_SIZE" \
    --image-family=ubuntu-2404-lts-amd64 \
    --image-project=ubuntu-os-cloud \
    --scopes=https://www.googleapis.com/auth/cloud-platform \
    --metadata-from-file=startup-script="$startup" \
    --maintenance-policy=TERMINATE \
    --max-run-duration="$TIMEOUT" \
    --instance-termination-action=DELETE \
    --labels="ol-c-purpose=firefox-remote-build,ol-c-job=${job_id}"; then
    cat >&2 <<EOF
VM creation failed. Common causes are H4D quota, zone availability, or an older gcloud without max-run-duration support.

Try another H4D zone:
  OLC_GCP_LOCATION=europe-west4 OLC_GCP_ZONE=europe-west4-b $0 ${target}

Or use the smaller fallback:
  OLC_GCP_MACHINE_TYPE=c2-standard-30 OLC_GCP_BOOT_DISK_TYPE=pd-ssd $0 ${target}
EOF
    echo "Cleaning up uploaded source artifacts at ${run_uri}/" >&2
    gcloud_quiet storage rm --recursive "$run_uri" || true
    rm -rf "$tmpdir"
    return 1
  fi

  rm -rf "$tmpdir"

  echo
  echo "VM submitted: ${job_id}"
  echo "Compute Engine will delete it after ${TIMEOUT} even if this local script exits."
  echo "Kill it at any time with:"
  echo "  $0 --kill ${job_id}"
  echo

  if wait_for_job "$job_id"; then
    fetch_result "$job_id"
  else
    echo "Build failed. Fetch logs with:"
    echo "  gcloud storage cp $(run_prefix "$job_id")/build.log ."
    echo "Delete the VM if it still exists with:"
    echo "  gcloud compute instances delete ${job_id} --zone=${ZONE} --project=${PROJECT} --quiet"
    return 1
  fi
}

show_status() {
  local job_id="$1" state remote_status
  state="$(instance_state "$job_id")"
  remote_status="$(status_artifact "$job_id" || true)"
  echo "Job: ${job_id}"
  echo "Instance: ${state:-not found}"
  echo "Remote status: ${remote_status:-not uploaded}"
  echo "Artifacts: $(run_prefix "$job_id")/"
  echo
  gcloud compute instances describe "$job_id" \
    --project="$PROJECT" \
    --zone="$ZONE" \
    --format='yaml(name,status,creationTimestamp,lastStartTimestamp,scheduling.maxRunDuration,labels)' 2>/dev/null || true
}

show_logs() {
  local job_id="$1" tmp
  echo "Serial output for ${job_id}:"
  print_serial_output "$job_id"
  echo
  tmp="$(mktemp)"
  if gcloud_quiet storage cp "$(run_prefix "$job_id")/build.log" "$tmp" >/dev/null 2>&1; then
    echo "Uploaded build log:"
    sed -n '1,260p' "$tmp"
  else
    echo "Uploaded build log is not available yet."
  fi
  rm -f "$tmp"
}

kill_job() {
  local job_id="$1"
  echo "Deleting Compute Engine VM ${job_id}; this cancels the running build and releases compute."
  gcloud_quiet compute instances delete "$job_id" \
    --project="$PROJECT" \
    --zone="$ZONE"
}

cleanup_run() {
  local job_id="$1"
  echo "Deleting GCS artifacts at $(run_prefix "$job_id")/"
  gcloud_quiet storage rm --recursive "$(run_prefix "$job_id")"
}

main() {
  local mode="submit" dry_run="0" target="$DEFAULT_TARGET" job_id=""

  case "${1:-}" in
    --help|-h)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run="1"
      shift
      target="${1:-$DEFAULT_TARGET}"
      ;;
    --logs|--status|--fetch|--kill|--cleanup)
      mode="${1#--}"
      shift
      job_id="${1:-}"
      [[ -n "$job_id" ]] || fail "--${mode} requires JOB_ID"
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    "")
      ;;
    *)
      target="$1"
      ;;
  esac

  require_command gcloud
  case "$mode" in
    submit)
      confirm_gcloud_identity
      resolve_settings 1
      ;;
    *)
      resolve_settings 0
      ;;
  esac

  case "$mode" in
    submit)
      require_command tar
      submit_build "$target" "$dry_run"
      ;;
    logs)
      show_logs "$job_id"
      ;;
    status)
      show_status "$job_id"
      ;;
    fetch)
      require_command tar
      fetch_result "$job_id"
      ;;
    kill)
      kill_job "$job_id"
      ;;
    cleanup)
      cleanup_run "$job_id"
      ;;
    *)
      fail "unknown mode: $mode"
      ;;
  esac
}

main "$@"
